        f"SELECT display_form FROM source_translation_seeds WHERE dataset_id IN ({placeholders})",
        dataset_ids,
    ).fetchall()
    lexicon = set()
    for row in rows:
        for variant in display_form_variants(row["display_form"]):
            lexicon.add(variant)
    return lexicon


