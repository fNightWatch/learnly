import sys
sys.path.insert(0, '/Users/moi/Desktop/business/learnly/corpus-generation')
import orchestrator
orchestrator.set_db_path('/Users/moi/Desktop/business/learnly/corpus-generation/corpus-hsk-5.sqlite')
conn = orchestrator.connect()
lex = orchestrator.build_allowed_lexicon('new-hsk-5-words', conn)
max_len = max(len(x) for x in lex)

def segment(text):
    text = orchestrator.clean_sentence_for_segmentation(text)
    failed = {}
    def dfs(i):
        if i == len(text):
            return []
        if i in failed:
            return None
        upper = min(len(text), i + max_len)
        for end in range(upper, i, -1):
            tok = text[i:end]
            if tok in lex:
                rest = dfs(end)
                if rest is not None:
                    return [tok] + rest
        failed[i] = True
        return None
    return dfs(0)

sentences = [
'工作人员把椅子按号码排列在门口。','孩子们在操场边排列得很整齐。','这些照片按时间排列以后更清楚。',
'公司明天派我去上海参加培训。','医院马上派了两位医生去现场。','老师派我在门口接新同学。',
