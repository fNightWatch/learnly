+{"word": {"id": "new-hsk-5-0819", "lang": "zh", "lemma": "配", "display_form": "配", "pos": "verb, adjective", "rank": 819, "pronunciation": "pèi"}, "glosses": {"primary_gloss": "to match", "secondary_glosses": ["to go with", "to be suited to", "well-matched"], "notes": "As a verb, 配 means to match or pair things together. As an adjective, it means fitting or well-matched."}, "examples": [{"id": "new-hsk-5-0819-ex1", "meaning_en": "to match", "sentence": "这条蓝裙子配白鞋，看着很干净。", "translation": "This blue dress goes well with white shoes and looks very clean.", "difficulty": 2, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0819-ex2", "meaning_en": "to be suited to", "sentence": "我觉得她很配这份需要耐心的工作。", "translation": "I think she is very well suited to this job, which needs patience.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0819-ex3", "meaning_en": "to go with", "sentence": "热汤配米饭，吃起来更舒服。", "translation": "Hot soup goes well with rice and feels more comforting to eat.", "difficulty": 2, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0819-ex1", "translation": "This blue dress goes well with white shoes and looks very clean."}, {"example_id": "new-hsk-5-0819-ex2", "translation": "I think she is very well suited to this job, which needs patience."}, {"example_id": "new-hsk-5-0819-ex3", "translation": "Hot soup goes well with rice and feels more comforting to eat."}]}
