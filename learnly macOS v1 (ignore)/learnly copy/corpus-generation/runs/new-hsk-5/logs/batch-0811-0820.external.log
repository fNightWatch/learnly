-{"word":{"id":"new-hsk-5-0813","lang":"zh","lemma":"派出所","display_form":"派出所","pos":"noun","rank":813,"pronunciation":"pàichūsuǒ"},"glosses":{"primary_gloss":"local police station","secondary_glosses":["police substation"],"notes":"派出所 is the neighborhood-level police station people go to for common local police matters such as reporting a loss or asking for help."},"examples":[{"id":"new-hsk-5-0813-ex1","meaning_en":"local police station","sentence":"她马上去了派出所。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0813-ex2","meaning_en":"local police station","sentence":"我们小区旁边就有一个派出所。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0813-ex3","meaning_en":"police station","sentence":"他在派出所把经过都说清楚了。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0813-ex1","translation":"She went straight to the local police station."},{"example_id":"new-hsk-5-0813-ex2","translation":"There is a local police station right next to our housing compound."},{"example_id":"new-hsk-5-0813-ex3","translation":"He explained the whole course of events clearly at the police station."}]}
-{"word":{"id":"new-hsk-5-0814","lang":"zh","lemma":"跑道","display_form":"跑道","pos":"noun","rank":814,"pronunciation":"pǎodào"},"glosses":{"primary_gloss":"track","secondary_glosses":["runway"],"notes":"跑道 usually means the track for running, but it can also mean the runway for planes when the setting is an airport."},"examples":[{"id":"new-hsk-5-0814-ex1","meaning_en":"track","sentence":"下雨以后，学校的跑道还有点儿湿。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0814-ex2","meaning_en":"runway","sentence":"飞机已经进入跑道，快要起飞了。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0814-ex3","meaning_en":"track","sentence":"他每天早上都在跑道上练长跑。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0814-ex1","translation":"After the rain, the school's track is still a little wet."},{"example_id":"new-hsk-5-0814-ex2","translation":"The plane has already entered the runway and is about to take off."},{"example_id":"new-hsk-5-0814-ex3","translation":"He practices long-distance running on the track every morning."}]}
-{"word":{"id":"new-hsk-5-0815","lang":"zh","lemma":"赔","display_form":"赔","pos":"verb","rank":815,"pronunciation":"péi"},"glosses":{"primary_gloss":"to compensate","secondary_glosses":["to pay for damage","to lose money"],"notes":"赔 is used when you make up for someone else's loss or damage, and it can also mean losing money yourself in business."},"examples":[{"id":"new-hsk-5-0815-ex1","meaning_en":"compensate","sentence":"这家店答应赔我一个新杯子。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0815-ex2","meaning_en":"lose money","sentence":"这笔生意没做好，公司赔了不少钱。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0815-ex3","meaning_en":"pay for damage","sentence":"你打坏了别人的眼镜，当然要赔。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0815-ex1","translation":"This shop agreed to compensate me with a new cup."},{"example_id":"new-hsk-5-0815-ex2","translation":"This deal did not go well, and the company lost quite a bit of money."},{"example_id":"new-hsk-5-0815-ex3","translation":"You broke someone else's glasses, so of course you have to pay for them."}]}
-{"word":{"id":"new-hsk-5-0816","lang":"zh","lemma":"陪伴","display_form":"陪伴","pos":"verb","rank":816,"pronunciation":"péibàn"},"glosses":{"primary_gloss":"to keep someone company","secondary_glosses":["to accompany"],"notes":"陪伴 is used for staying with someone over time, especially to support, comfort, or care for them."},"examples":[{"id":"new-hsk-5-0816-ex1","meaning_en":"accompany","sentence":"孩子小时候，很需要父母陪伴。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0816-ex2","meaning_en":"keep someone company","sentence":"那只老狗一直陪伴着爷爷。","difficulty":2,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0816-ex3","meaning_en":"stay with someone","sentence":"谢谢你在我最难的时候陪伴我。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0816-ex1","translation":"When children are young, they really need their parents to be with them."},{"example_id":"new-hsk-5-0816-ex2","translation":"That old dog has been keeping Grandpa company all along."},{"example_id":"new-hsk-5-0816-ex3","translation":"Thank you for staying with me during my hardest time."}]}
-{"word":{"id":"new-hsk-5-0817","lang":"zh","lemma":"培训","display_form":"培训","pos":"verb, noun","rank":817,"pronunciation":"péixùn"},"glosses":{"primary_gloss":"to train","secondary_glosses":["training"],"notes":"培训 can mean training people for work or skills, and it also commonly refers to the training session or program itself."},"examples":[{"id":"new-hsk-5-0817-ex1","meaning_en":"train","sentence":"公司下周要培训新来的员工。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0817-ex2","meaning_en":"train","sentence":"工作前，公司会先培训大家。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0817-ex3","meaning_en":"training","sentence":"这个培训让我学会了新的服务方法。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0817-ex1","translation":"The company is going to train the new employees next week."},{"example_id":"new-hsk-5-0817-ex2","translation":"Before work starts, the company will train everyone first."},{"example_id":"new-hsk-5-0817-ex3","translation":"This training helped me learn a new service method."}]}
-{"word":{"id":"new-hsk-5-0818","lang":"zh","lemma":"培养","display_form":"培养","pos":"verb","rank":818,"pronunciation":"péiyǎng"},"glosses":{"primary_gloss":"to cultivate","secondary_glosses":["to develop","to foster"],"notes":"培养 is used for patiently developing habits, abilities, interests, or talent over time."},"examples":[{"id":"new-hsk-5-0818-ex1","meaning_en":"cultivate","sentence":"父母应该从小培养孩子的好习惯。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0818-ex2","meaning_en":"develop","sentence":"学校想培养学生独立想问题的能力。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0818-ex3","meaning_en":"foster","sentence":"老师在慢慢培养大家的信心。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0818-ex1","translation":"Parents should cultivate good habits in their children from an early age."},{"example_id":"new-hsk-5-0818-ex2","translation":"The school wants to develop the students' ability to think independently."},{"example_id":"new-hsk-5-0818-ex3","translation":"The teacher is slowly building everyone's confidence."}]}
-{"word":{"id":"new-hsk-5-0819","lang":"zh","lemma":"配","display_form":"配","pos":"verb","rank":819,"pronunciation":"pèi"},"glosses":{"primary_gloss":"to match","secondary_glosses":["to suit","to deserve"],"notes":"配 usually means to match or go well with something. In patterns like 不配, it means not deserving or not being worthy of something."},"examples":[{"id":"new-hsk-5-0819-ex1","meaning_en":"match","sentence":"这件外套配黑裤子很好看。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0819-ex2","meaning_en":"go well with","sentence":"这件衣服和黑裤子更配。","difficulty":2,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0819-ex3","meaning_en":"deserve","sentence":"他觉得自己还不配这个机会。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0819-ex1","translation":"This coat looks very good with black pants."},{"example_id":"new-hsk-5-0819-ex2","translation":"This piece of clothing goes better with black pants."},{"example_id":"new-hsk-5-0819-ex3","translation":"He feels that he still does not deserve this opportunity."}]}
-{"word":{"id":"new-hsk-5-0820","lang":"zh","lemma":"配合","display_form":"配合","pos":"verb","rank":820,"pronunciation":"pèihé"},"glosses":{"primary_gloss":"to cooperate","secondary_glosses":["to coordinate","to work well together"],"notes":"配合 covers cooperating with people, coordinating tasks, and things working well together."},"examples":[{"id":"new-hsk-5-0820-ex1","meaning_en":"cooperate","sentence":"请大家配合一下，先把手机关掉。","difficulty":2,"source":"subagent-22","is_primary":true},{"id":"new-hsk-5-0820-ex2","meaning_en":"coordinate","sentence":"两个部门正在配合完成这个计划。","difficulty":3,"source":"subagent-22","is_primary":false},{"id":"new-hsk-5-0820-ex3","meaning_en":"work well together","sentence":"灯光和音乐配合得非常自然。","difficulty":3,"source":"subagent-22","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0820-ex1","translation":"Please cooperate for a moment and turn off your phones first."},{"example_id":"new-hsk-5-0820-ex2","translation":"The two departments are coordinating to complete this plan."},{"example_id":"new-hsk-5-0820-ex3","translation":"The lighting and the music work together very naturally."}]}
+{"word": {"id": "new-hsk-5-0811", "lang": "zh", "lemma": "排列", "display_form": "排列", "pos": "verb", "rank": 811, "pronunciation": "páiliè"}, "glosses": {"primary_gloss": "to arrange", "secondary_glosses": ["to line up", "to put in order"], "notes": "Used for putting people or things into a clear order, sequence, or line."}, "examples": [{"id": "new-hsk-5-0811-ex1", "meaning_en": "to arrange", "sentence": "工作人员把椅子按顺序排列在门口。", "translation": "The staff arranged the chairs in order at the entrance.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0811-ex2", "meaning_en": "to line up", "sentence": "孩子们在操场边排列得很整齐。", "translation": "The children lined up neatly by the playground.", "difficulty": 2, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0811-ex3", "meaning_en": "to put in order", "sentence": "这些照片按时间排列以后更清楚。", "translation": "These photos are clearer after being arranged by time.", "difficulty": 3, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0811-ex1", "translation": "The staff arranged the chairs in order at the entrance."}, {"example_id": "new-hsk-5-0811-ex2", "translation": "The children lined up neatly by the playground."}, {"example_id": "new-hsk-5-0811-ex3", "translation": "These photos are clearer after being arranged by time."}]}
+{"word": {"id": "new-hsk-5-0812", "lang": "zh", "lemma": "派", "display_form": "派", "pos": "verb, noun", "rank": 812, "pronunciation": "pài"}, "glosses": {"primary_gloss": "to send", "secondary_glosses": ["to dispatch", "group; school; faction"], "notes": "As a verb, 派 means to send or assign someone. As a noun, it can mean a group, style, or faction with shared views."}, "examples": [{"id": "new-hsk-5-0812-ex1", "meaning_en": "to send", "sentence": "公司明天派我去上海参加培训。", "translation": "The company is sending me to Shanghai for training tomorrow.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0812-ex2", "meaning_en": "to dispatch", "sentence": "医院马上派了两位医生去现场。", "translation": "The hospital immediately dispatched two doctors to the scene.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0812-ex3", "meaning_en": "to assign", "sentence": "老师派我在门口接新同学。", "translation": "The teacher assigned me to greet the new students at the door.", "difficulty": 2, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0812-ex1", "translation": "The company is sending me to Shanghai for training tomorrow."}, {"example_id": "new-hsk-5-0812-ex2", "translation": "The hospital immediately dispatched two doctors to the scene."}, {"example_id": "new-hsk-5-0812-ex3", "translation": "The teacher assigned me to greet the new students at the door."}]}
+{"word": {"id": "new-hsk-5-0813", "lang": "zh", "lemma": "派出所", "display_form": "派出所", "pos": "noun", "rank": 813, "pronunciation": "pàichūsuǒ"}, "glosses": {"primary_gloss": "police station", "secondary_glosses": ["police substation", "local police station"], "notes": "Mainland Chinese term for a neighborhood police station or local public-security office."}, "examples": [{"id": "new-hsk-5-0813-ex1", "meaning_en": "police station", "sentence": "护照不见以后，我先去派出所登记。", "translation": "After my passport went missing, I first went to the police station to register it.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0813-ex2", "meaning_en": "local police station", "sentence": "警察让我们到派出所把情况说清楚。", "translation": "The police told us to go to the police station and explain the situation clearly.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0813-ex3", "meaning_en": "police substation", "sentence": "这个派出所晚上也有人值班。", "translation": "This police substation also has people on duty at night.", "difficulty": 2, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0813-ex1", "translation": "After my passport went missing, I first went to the police station to register it."}, {"example_id": "new-hsk-5-0813-ex2", "translation": "The police told us to go to the police station and explain the situation clearly."}, {"example_id": "new-hsk-5-0813-ex3", "translation": "This police substation also has people on duty at night."}]}
+{"word": {"id": "new-hsk-5-0814", "lang": "zh", "lemma": "跑道", "display_form": "跑道", "pos": "noun", "rank": 814, "pronunciation": "pǎodào"}, "glosses": {"primary_gloss": "track", "secondary_glosses": ["runway"], "notes": "Can mean a running track in sports or a runway at an airport."}, "examples": [{"id": "new-hsk-5-0814-ex1", "meaning_en": "track", "sentence": "下雨以后，学校的跑道还有一点湿。", "translation": "After the rain, the school track was still a little wet.", "difficulty": 2, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0814-ex2", "meaning_en": "runway", "sentence": "飞机在跑道上等了十分钟才起飞。", "translation": "The plane waited on the runway for ten minutes before taking off.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0814-ex3", "meaning_en": "track", "sentence": "她每天都去学校的跑道上跑步。", "translation": "She goes to run on the school track every day.", "difficulty": 2, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0814-ex1", "translation": "After the rain, the school track was still a little wet."}, {"example_id": "new-hsk-5-0814-ex2", "translation": "The plane waited on the runway for ten minutes before taking off."}, {"example_id": "new-hsk-5-0814-ex3", "translation": "She goes to run on the school track every day."}]}
+{"word": {"id": "new-hsk-5-0815", "lang": "zh", "lemma": "赔", "display_form": "赔", "pos": "verb", "rank": 815, "pronunciation": "péi"}, "glosses": {"primary_gloss": "to compensate", "secondary_glosses": ["to pay for a loss", "to lose money"], "notes": "Used for paying compensation after damage or loss. In business contexts, 赔钱 means to lose money."}, "examples": [{"id": "new-hsk-5-0815-ex1", "meaning_en": "to compensate", "sentence": "店长答应赔顾客一件新的外套。", "translation": "The store manager agreed to compensate the customer with a new coat.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0815-ex2", "meaning_en": "to lose money", "sentence": "这家店去年没赚钱，反而赔了不少钱。", "translation": "Last year this shop did not make money; instead, it lost quite a lot.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0815-ex3", "meaning_en": "to pay for the damage", "sentence": "如果你把杯子打碎了，就得赔给老板。", "translation": "If you break the cup, you have to pay the boss for it.", "difficulty": 2, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0815-ex1", "translation": "The store manager agreed to compensate the customer with a new coat."}, {"example_id": "new-hsk-5-0815-ex2", "translation": "Last year this shop did not make money; instead, it lost quite a lot."}, {"example_id": "new-hsk-5-0815-ex3", "translation": "If you break the cup, you have to pay the boss for it."}]}
+{"word": {"id": "new-hsk-5-0816", "lang": "zh", "lemma": "陪伴", "display_form": "陪伴", "pos": "verb", "rank": 816, "pronunciation": "péibàn"}, "glosses": {"primary_gloss": "to accompany", "secondary_glosses": ["to keep someone company", "to stay by someone’s side"], "notes": "Used when being with someone over time, especially to give comfort or company."}, "examples": [{"id": "new-hsk-5-0816-ex1", "meaning_en": "to accompany", "sentence": "外婆住院的时候，妈妈一直陪伴着她。", "translation": "When Grandma was in the hospital, Mom stayed by her side the whole time.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0816-ex2", "meaning_en": "to keep someone company", "sentence": "小时候那只狗陪伴了我很多年。", "translation": "That dog kept me company for many years when I was little.", "difficulty": 2, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0816-ex3", "meaning_en": "to stay by someone’s side", "sentence": "最难的时候，是姐姐一直在陪伴我。", "translation": "During the hardest time, it was my older sister who stayed by my side.", "difficulty": 3, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0816-ex1", "translation": "When Grandma was in the hospital, Mom stayed by her side the whole time."}, {"example_id": "new-hsk-5-0816-ex2", "translation": "That dog kept me company for many years when I was little."}, {"example_id": "new-hsk-5-0816-ex3", "translation": "During the hardest time, it was my older sister who stayed by my side."}]}
+{"word": {"id": "new-hsk-5-0817", "lang": "zh", "lemma": "培训", "display_form": "培训", "pos": "verb", "rank": 817, "pronunciation": "péixùn"}, "glosses": {"primary_gloss": "to train", "secondary_glosses": ["to provide training"], "notes": "Used for organized professional or skills training."}, "examples": [{"id": "new-hsk-5-0817-ex1", "meaning_en": "to train", "sentence": "公司下周要培训刚来的新员工。", "translation": "The company will train the newly arrived employees next week.", "difficulty": 3, "source": "generator-2", "is_primary": true}, {"id": "new-hsk-5-0817-ex2", "meaning_en": "to provide training", "sentence": "学校请专家来培训年轻老师。", "translation": "The school invited experts to train the young teachers.", "difficulty": 3, "source": "generator-2", "is_primary": false}, {"id": "new-hsk-5-0817-ex3", "meaning_en": "to train", "sentence": "这套课程专门培训社区里的急救志愿者。", "translation": "This course is specifically for training first-aid volunteers in the community.", "difficulty": 3, "source": "generator-2", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0817-ex1", "translation": "The company will train the newly arrived employees next week."}, {"example_id": "new-hsk-5-0817-ex2", "translation": "The school invited experts to train the young teachers."}, {"example_id": "new-hsk-5-0817-ex3", "translation": "This course is specifically for training first-aid volunteers in the community."}]}
