import sqlite3, re
DB='/Users/moi/Desktop/business/learnly/corpus-generation/corpus-hsk-5.sqlite'
ALT_SEPARATOR_RE = re.compile(r\"\\s*[｜|/]\\s*\")
ANNOTATION_RE = re.compile(r\"（["'^）]*）")
CHINESE_PUNCT_RE = re.compile(r"[，。！？；：、“”‘’（）《》〈〉【】—…·'"\\s,."'!?;:'"\\\"'()\\[\\]{}-]+\")
TRAILING_SENSE_DIGIT_RE = re.compile(r\""'^(['"\\u3400-\\u9fff]+)\\d+"'$")

def display_form_variants(display_form: str):
    variants=[]
    for part in ALT_SEPARATOR_RE.split(display_form.strip()):
        cleaned = ANNOTATION_RE.sub('"'', part).strip()
        if not cleaned:
            continue
        m = TRAILING_SENSE_DIGIT_RE.match(cleaned)
        candidates = [cleaned] if not m else [m.group(1), cleaned]
        for c in candidates:
            if c and c not in variants:
                variants.append(c)
    return variants or [display_form.strip()]

def clean(sentence: str):
    return CHINESE_PUNCT_RE.sub('', sentence)

def can_segment(text, lexicon):
    if not text:
        return True
    max_len = max((len(t) for t in lexicon), default=0)
    failed=set()
    def dfs(i):
        if i == len(text): return True
        if i in failed: return False
        upper=min(len(text), i+max_len)
        for end in range(upper, i, -1):
            if text[i:end] in lexicon and dfs(end): return True
        failed.add(i)
        return False
    return dfs(0)

