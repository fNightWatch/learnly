            details = "; ".join(f"{row['word_id']}::{row['id']}" for row in group)
            for row in group:
                issues.append(
                    {
                        "issue_type": "cross_word_duplicate_translation",
                        "word_id": row["word_id"],
                        "example_id": row["id"],
                        "rank": row["rank"],
                        "sentence": row["sentence"],
                        "translation": translation,
                        "details": details,
