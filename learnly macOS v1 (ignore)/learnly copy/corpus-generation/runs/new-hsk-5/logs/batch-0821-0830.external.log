+{"word":{"id":"new-hsk-5-0824","lang":"zh","lemma":"碰见","display_form":"碰见","pos":"verb","rank":824,"pronunciation":"pèngjiàn"},"glosses":{"primary_gloss":"to run into","secondary_glosses":["to meet by chance"],"notes":"Verb for unexpectedly meeting someone in ordinary daily situations."},"examples":[{"id":"new-hsk-5-0824-ex1","meaning_en":"to run into","sentence":"我刚出地铁站，就碰见了以前的老师。","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-5-0824-ex2","meaning_en":"to run into","sentence":"她在路上碰见妈妈，才知道家里来客人了。","difficulty":3,"source":"generator-3","is_primary":false},{"id":"new-hsk-5-0824-ex3","meaning_en":"to meet by chance","sentence":"我们只想买面包，却碰见了正在找我们的朋友。","difficulty":3,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0824-ex1","translation":"I had just come out of the subway station when I ran into one of my former teachers."},{"example_id":"new-hsk-5-0824-ex2","translation":"She ran into her mother on the way and only then learned that guests had come to the house."},{"example_id":"new-hsk-5-0824-ex3","translation":"We only wanted to buy bread, but we ran into the friend who was looking for us."}]}
