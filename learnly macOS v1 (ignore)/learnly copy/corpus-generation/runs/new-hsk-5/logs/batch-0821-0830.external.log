+{"word":{"id":"new-hsk-5-0826","lang":"zh","lemma":"批","display_form":"批","pos":"verb","rank":826,"pronunciation":"pī"},"glosses":{"primary_gloss":"to criticize","secondary_glosses":["to mark","to approve"],"notes":"Commonly means to criticize or scold. In school contexts it can mean to mark written work, and in formal contexts it can mean to approve."},"examples":[{"id":"new-hsk-5-0826-ex1","meaning_en":"to criticize","sentence":"因为我又迟到了，经理开会时当面批了我。","difficulty":3,"source":"generator-3","is_primary":true},{"id":"new-hsk-5-0826-ex2","meaning_en":"to mark","sentence":"老师把我们的作业都批了。","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-5-0826-ex3","meaning_en":"to approve","sentence":"领导已经把这个计划批了，我们明天就做。","difficulty":3,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-5-0826-ex1","translation":"Because I was late again, the manager criticized me to my face during the meeting."},{"example_id":"new-hsk-5-0826-ex2","translation":"The teacher marked all of our homework."},{"example_id":"new-hsk-5-0826-ex3","translation":"The leadership has already approved this plan, so we'll start on it tomorrow."}]}
