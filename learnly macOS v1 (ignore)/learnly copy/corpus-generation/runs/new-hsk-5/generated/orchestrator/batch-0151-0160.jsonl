{"word": {"id": "new-hsk-5-0151", "lang": "zh", "lemma": "成员", "display_form": "成员", "pos": "noun", "rank": 151, "pronunciation": "chéngyuán"}, "glosses": {"primary_gloss": "member", "secondary_glosses": ["team member"], "notes": "A person who belongs to a group, team, or organization."}, "examples": [{"id": "new-hsk-5-0151-ex1", "meaning_en": "member", "sentence": "我是这个队里最年轻的成员。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0151-ex2", "meaning_en": "member", "sentence": "新成员来了以后，大家先一起吃饭。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0151-ex3", "meaning_en": "member", "sentence": "每个成员都得自己准备材料。", "difficulty": 3, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0151-ex1", "translation": "I am the youngest member of this team."}, {"example_id": "new-hsk-5-0151-ex2", "translation": "After the new member arrived, everyone ate together first."}, {"example_id": "new-hsk-5-0151-ex3", "translation": "Every member has to prepare their own materials."}]}
{"word": {"id": "new-hsk-5-0152", "lang": "zh", "lemma": "成长", "display_form": "成长", "pos": "verb", "rank": 152, "pronunciation": "chéngzhǎng"}, "glosses": {"primary_gloss": "grow up", "secondary_glosses": ["grow", "develop"], "notes": "Used for people or things developing over time and becoming more mature or stronger."}, "examples": [{"id": "new-hsk-5-0152-ex1", "meaning_en": "grow up", "sentence": "孩子在爱里慢慢成长。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0152-ex2", "meaning_en": "grow", "sentence": "这几年，他在工作里成长得很快。", "difficulty": 3, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0152-ex3", "meaning_en": "develop", "sentence": "人常在小错里慢慢成长。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0152-ex1", "translation": "A child grows up little by little in a loving environment."}, {"example_id": "new-hsk-5-0152-ex2", "translation": "These past few years, he has grown quickly through his work."}, {"example_id": "new-hsk-5-0152-ex3", "translation": "People often grow little by little through small mistakes."}]}
{"word": {"id": "new-hsk-5-0153", "lang": "zh", "lemma": "橙子", "display_form": "橙子", "pos": "noun", "rank": 153, "pronunciation": "chéngzi"}, "glosses": {"primary_gloss": "orange", "secondary_glosses": [], "notes": "The fruit orange. This word usually refers to the fruit, not the color."}, "examples": [{"id": "new-hsk-5-0153-ex1", "meaning_en": "orange", "sentence": "早上我吃了一个很甜的橙子。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0153-ex2", "meaning_en": "orange", "sentence": "她把橙子切开，大家一起吃。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0153-ex3", "meaning_en": "orange", "sentence": "我买了三个橙子，准备带回家。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0153-ex1", "translation": "This morning I ate a sweet orange."}, {"example_id": "new-hsk-5-0153-ex2", "translation": "She cut the orange open and everyone ate together."}, {"example_id": "new-hsk-5-0153-ex3", "translation": "I bought three oranges and got ready to take them home."}]}
{"word": {"id": "new-hsk-5-0154", "lang": "zh", "lemma": "池", "display_form": "池", "pos": "noun", "rank": 154, "pronunciation": "chí"}, "glosses": {"primary_gloss": "pool", "secondary_glosses": ["pond"], "notes": "A pool or pond where water stays collected in one place."}, "examples": [{"id": "new-hsk-5-0154-ex1", "meaning_en": "pool", "sentence": "孩子站在池边，不敢下水。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0154-ex2", "meaning_en": "pond", "sentence": "院子后面有个小池，里面还有鱼。", "difficulty": 3, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0154-ex3", "meaning_en": "pond", "sentence": "这个池里有很多鱼。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0154-ex1", "translation": "The child stood by the pool and did not dare go into the water."}, {"example_id": "new-hsk-5-0154-ex2", "translation": "Behind the yard there is a small pond, and there are even fish in it."}, {"example_id": "new-hsk-5-0154-ex3", "translation": "There are a lot of fish in this pond."}]}
{"word": {"id": "new-hsk-5-0155", "lang": "zh", "lemma": "持续", "display_form": "持续", "pos": "verb", "rank": 155, "pronunciation": "chíxù"}, "glosses": {"primary_gloss": "continue", "secondary_glosses": ["last", "go on"], "notes": "Used when something keeps going for a period of time without stopping."}, "examples": [{"id": "new-hsk-5-0155-ex1", "meaning_en": "continue", "sentence": "雨从早上持续到晚上。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0155-ex2", "meaning_en": "last", "sentence": "这种情况已经持续了三天。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0155-ex3", "meaning_en": "go on", "sentence": "这个活动会持续到下周。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0155-ex1", "translation": "The rain continued from morning to evening."}, {"example_id": "new-hsk-5-0155-ex2", "translation": "This situation has already lasted three days."}, {"example_id": "new-hsk-5-0155-ex3", "translation": "This activity will continue until next week."}]}
{"word": {"id": "new-hsk-5-0156", "lang": "zh", "lemma": "尺子", "display_form": "尺子", "pos": "noun", "rank": 156, "pronunciation": "chǐzi"}, "glosses": {"primary_gloss": "ruler", "secondary_glosses": [], "notes": "The straight measuring tool used at school or at a desk."}, "examples": [{"id": "new-hsk-5-0156-ex1", "meaning_en": "ruler", "sentence": "这把尺子在这里，你先用吧。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0156-ex2", "meaning_en": "ruler", "sentence": "老师叫我拿尺子画一条线。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0156-ex3", "meaning_en": "ruler", "sentence": "他拿尺子量了一下门的宽。", "difficulty": 3, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0156-ex1", "translation": "This ruler is here; use it first."}, {"example_id": "new-hsk-5-0156-ex2", "translation": "The teacher told me to use a ruler to draw a line."}, {"example_id": "new-hsk-5-0156-ex3", "translation": "He used a ruler to measure the width of the door."}]}
{"word": {"id": "new-hsk-5-0157", "lang": "zh", "lemma": "翅膀", "display_form": "翅膀", "pos": "noun", "rank": 157, "pronunciation": "chìbǎng"}, "glosses": {"primary_gloss": "wing", "secondary_glosses": [], "notes": "The wing of a bird, plane, or another thing that flies."}, "examples": [{"id": "new-hsk-5-0157-ex1", "meaning_en": "wing", "sentence": "那只小鸟的翅膀受伤了。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0157-ex2", "meaning_en": "wing", "sentence": "孩子给飞机画了蓝色的翅膀。", "difficulty": 3, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0157-ex3", "meaning_en": "wings", "sentence": "风一大，鸡张开翅膀就跑。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0157-ex1", "translation": "That little bird's wing is injured."}, {"example_id": "new-hsk-5-0157-ex2", "translation": "The child drew blue wings on the airplane."}, {"example_id": "new-hsk-5-0157-ex3", "translation": "When the wind picked up, the chicken spread its wings and ran."}]}
{"word": {"id": "new-hsk-5-0158", "lang": "zh", "lemma": "冲", "display_form": "冲", "pos": "verb", "rank": 158, "pronunciation": "chōng"}, "glosses": {"primary_gloss": "rush", "secondary_glosses": ["rinse", "make a hot drink"], "notes": "A flexible everyday verb: rush forward, rinse something with water, or make a drink by pouring in hot water."}, "examples": [{"id": "new-hsk-5-0158-ex1", "meaning_en": "rush", "sentence": "门一开，孩子就冲了出去。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0158-ex2", "meaning_en": "rinse", "sentence": "把这个杯子冲一下再用。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0158-ex3", "meaning_en": "make a hot drink", "sentence": "他给我冲了一杯热茶。", "difficulty": 3, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0158-ex1", "translation": "As soon as the door opened, the child rushed out."}, {"example_id": "new-hsk-5-0158-ex2", "translation": "Rinse this cup once before using it."}, {"example_id": "new-hsk-5-0158-ex3", "translation": "He made me a cup of hot tea."}]}
{"word": {"id": "new-hsk-5-0159", "lang": "zh", "lemma": "充电", "display_form": "充电", "pos": "verb", "rank": 159, "pronunciation": "chōngdiàn"}, "glosses": {"primary_gloss": "charge", "secondary_glosses": ["recharge"], "notes": "To put power back into a phone, car, or other battery-powered device."}, "examples": [{"id": "new-hsk-5-0159-ex1", "meaning_en": "charge", "sentence": "手机快没电了，我先去充电。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0159-ex2", "meaning_en": "charge", "sentence": "这辆车晚上要充电。", "difficulty": 2, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0159-ex3", "meaning_en": "recharge", "sentence": "出门前，先给手机充电。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0159-ex1", "translation": "My phone is almost out of power, so I'll go charge it first."}, {"example_id": "new-hsk-5-0159-ex2", "translation": "This car needs to be charged at night."}, {"example_id": "new-hsk-5-0159-ex3", "translation": "Before going out, charge your phone first."}]}
{"word": {"id": "new-hsk-5-0160", "lang": "zh", "lemma": "充分", "display_form": "充分", "pos": "adjective", "rank": 160, "pronunciation": "chōngfèn"}, "glosses": {"primary_gloss": "sufficient", "secondary_glosses": ["ample"], "notes": "Enough in amount or degree for what is needed."}, "examples": [{"id": "new-hsk-5-0160-ex1", "meaning_en": "ample", "sentence": "我们有充分的时间慢慢谈。", "difficulty": 2, "source": "orchestrator", "is_primary": true}, {"id": "new-hsk-5-0160-ex2", "meaning_en": "well prepared", "sentence": "大家已经准备得很充分。", "difficulty": 3, "source": "orchestrator", "is_primary": false}, {"id": "new-hsk-5-0160-ex3", "meaning_en": "sufficient", "sentence": "时间很充分，你别急。", "difficulty": 2, "source": "orchestrator", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-5-0160-ex1", "translation": "We have plenty of time to talk slowly."}, {"example_id": "new-hsk-5-0160-ex2", "translation": "Everyone is already very well prepared."}, {"example_id": "new-hsk-5-0160-ex3", "translation": "There is plenty of time, so don't rush."}]}
