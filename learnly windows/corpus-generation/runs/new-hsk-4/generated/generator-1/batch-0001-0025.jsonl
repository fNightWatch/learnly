{"word": {"id": "new-hsk-4-0004", "lang": "zh", "lemma": "安检", "display_form": "安检", "pos": "verb", "rank": 4, "pronunciation": "ānjiǎn"}, "glosses": {"primary_gloss": "security check; security screening", "secondary_glosses": ["go through security"], "notes": "Used for the security screening people go through in places like airports and stations."}, "examples": [{"id": "new-hsk-4-0004-ex1", "meaning_en": "security check", "sentence": "上飞机前，大家都要过安检。", "difficulty": 2, "source": "generator-1", "is_primary": true}, {"id": "new-hsk-4-0004-ex2", "meaning_en": "security screening", "sentence": "这个机场的安检一直很快。", "difficulty": 2, "source": "generator-1", "is_primary": false}, {"id": "new-hsk-4-0004-ex3", "meaning_en": "go through security", "sentence": "他把水放下，再去安检。", "difficulty": 2, "source": "generator-1", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-4-0004-ex1", "translation": "Everyone has to go through security before boarding the plane."}, {"example_id": "new-hsk-4-0004-ex2", "translation": "Security screening at this airport is always fast."}, {"example_id": "new-hsk-4-0004-ex3", "translation": "He put the water down and then went through security."}]}
