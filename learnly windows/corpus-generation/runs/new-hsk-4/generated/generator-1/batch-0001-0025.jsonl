{"word": {"id": "new-hsk-4-0001", "lang": "zh", "lemma": "啊", "display_form": "啊", "pos": "interjection", "rank": 1, "pronunciation": "ā"}, "glosses": {"primary_gloss": "ah; oh", "secondary_glosses": [], "notes": "Common interjection used to show surprise, realization, or emphasis in speech."}, "examples": [{"id": "new-hsk-4-0001-ex1", "meaning_en": "oh", "sentence": "啊，你今天来得真早。", "difficulty": 2, "source": "generator-1", "is_primary": true}, {"id": "new-hsk-4-0001-ex2", "meaning_en": "ah", "sentence": "这个房间好安静啊。", "difficulty": 2, "source": "generator-1", "is_primary": false}, {"id": "new-hsk-4-0001-ex3", "meaning_en": "oh", "sentence": "啊，我把护照忘在家里了。", "difficulty": 2, "source": "generator-1", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-4-0001-ex1", "translation": "Oh, you got here so early today."}, {"example_id": "new-hsk-4-0001-ex2", "translation": "This room is so quiet."}, {"example_id": "new-hsk-4-0001-ex3", "translation": "Oh, I left my passport at home."}]}
{"word": {"id": "new-hsk-4-0002", "lang": "zh", "lemma": "爱情", "display_form": "爱情", "pos": "noun", "rank": 2, "pronunciation": "àiqíng"}, "glosses": {"primary_gloss": "romantic love", "secondary_glosses": ["love between two people", "romance"], "notes": "Usually refers to romantic love between two people."}, "examples": [{"id": "new-hsk-4-0002-ex1", "meaning_en": "romantic love", "sentence": "这部电影写的是年轻人的爱情。", "difficulty": 2, "source": "generator-1", "is_primary": true}, {"id": "new-hsk-4-0002-ex2", "meaning_en": "love", "sentence": "她觉得爱情也需要时间。", "difficulty": 2, "source": "generator-1", "is_primary": false}, {"id": "new-hsk-4-0002-ex3", "meaning_en": "romantic love", "sentence": "大学毕业以后，他们还相信爱情。", "difficulty": 2, "source": "generator-1", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-4-0002-ex1", "translation": "This movie is about the romantic love of young people."}, {"example_id": "new-hsk-4-0002-ex2", "translation": "She thinks love also needs time."}, {"example_id": "new-hsk-4-0002-ex3", "translation": "After graduating from college, they still believe in love."}]}
