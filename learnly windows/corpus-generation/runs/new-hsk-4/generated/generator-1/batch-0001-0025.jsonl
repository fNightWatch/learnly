{"word": {"id": "new-hsk-4-0006", "lang": "zh", "lemma": "按", "display_form": "按", "pos": "verb, preposition", "rank": 6, "pronunciation": "àn"}, "glosses": {"primary_gloss": "press; according to", "secondary_glosses": ["push", "follow"], "notes": "Can mean to press something with your hand, or to act according to a rule or guide."}, "examples": [{"id": "new-hsk-4-0006-ex1", "meaning_en": "press", "sentence": "你先按一下这个开关。", "difficulty": 2, "source": "generator-1", "is_primary": true}, {"id": "new-hsk-4-0006-ex2", "meaning_en": "according to", "sentence": "我们按地图走，很快就到了。", "difficulty": 2, "source": "generator-1", "is_primary": false}, {"id": "new-hsk-4-0006-ex3", "meaning_en": "according to", "sentence": "请按老师说的顺序写。", "difficulty": 2, "source": "generator-1", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-4-0006-ex1", "translation": "Press this switch first."}, {"example_id": "new-hsk-4-0006-ex2", "translation": "We followed the map and got there quickly."}, {"example_id": "new-hsk-4-0006-ex3", "translation": "Please write in the order the teacher said."}]}
