   398	def compute_dataset_metrics(dataset_id: str) -> dict:
   399	    word_prefix = f"{dataset_word_prefix(dataset_id)}-%"
   400	    with connect() as conn:
   401	        word_count = conn.execute(
   402	            "SELECT COUNT(*) FROM words WHERE id LIKE ?",
   403	            (word_prefix,),
   404	        ).fetchone()[0]
   405	        example_rows = conn.execute(
   406	            """
   407	            SELECT e.sentence, e.difficulty
   408	            FROM examples e
   409	            JOIN words w ON w.id = e.word_id
   410	            WHERE w.id LIKE ?
   411	            ORDER BY w.rank, e.id
   412	            """,
   413	            (word_prefix,),
   414	        ).fetchall()
   415	        lexicon = build_allowed_lexicon(dataset_id, conn)
   416	
   417	    sentence_lengths: list[int] = []
   418	    token_counts: list[int] = []
   419	    difficulties: list[int] = []
   420	    segmentation_failures = 0
   421	    for row in example_rows:
   422	        sentence = row["sentence"]
   423	        difficulty = row["difficulty"]
   424	        sentence_lengths.append(len(sentence))
   425	        difficulties.append(difficulty)
   426	        segmented = segment_with_lexicon(clean_sentence_for_segmentation(sentence), lexicon)
   427	        if segmented is None:
   428	            segmentation_failures += 1
   429	            continue
   430	        token_counts.append(len(segmented))
   431	
   432	    example_count = len(example_rows)
   433	    avg_words = round(sum(token_counts) / len(token_counts), 3) if token_counts else 0.0
   434	    return {
   435	        "dataset_id": dataset_id,
   436	        "db_path": str(DB_PATH),
   437	        "word_count": word_count,
   438	        "example_count": example_count,
   439	        "avg_chars": round(sum(sentence_lengths) / example_count, 3) if example_count else 0.0,
   440	        "avg_words": avg_words,
   441	        "avg_tokens": avg_words,
   442	        "avg_difficulty": round(sum(difficulties) / len(difficulties), 3) if difficulties else 0.0,
   443	        "share_len_le_8": round(sum(1 for length in sentence_lengths if length <= 8) / example_count, 3) if example_count else 0.0,
   444	        "segmentation_failures": segmentation_failures,
   445	    }
