   337	def clean_sentence_for_segmentation(sentence: str) -> str:
   338	    return CHINESE_PUNCT_RE.sub("", sentence)
   339	
   340	
   341	def segment_with_lexicon(text: str, lexicon: set[str]) -> list[str] | None:
   342	    if not text:
   343	        return []
   344	    max_token_length = max((len(token) for token in lexicon), default=0)
   345	    failed: set[int] = set()
   346	    memo: dict[int, list[str] | None] = {}
   347	
   348	    def dfs(index: int) -> list[str] | None:
   349	        if index == len(text):
   350	            return []
   351	        if index in memo:
   352	            return memo[index]
   353	        if index in failed:
   354	            return None
   355	        upper = min(len(text), index + max_token_length)
   356	        for end in range(upper, index, -1):
   357	            token = text[index:end]
   358	            if token not in lexicon:
   359	                continue
   360	            rest = dfs(end)
   361	            if rest is not None:
   362	                memo[index] = [token] + rest
   363	                return memo[index]
   364	        failed.add(index)
   365	        memo[index] = None
   366	        return None
   367	
   368	    return dfs(0)
   369	
   370	
   371	def can_segment_with_lexicon(text: str, lexicon: set[str]) -> bool:
   372	    return segment_with_lexicon(text, lexicon) is not None
