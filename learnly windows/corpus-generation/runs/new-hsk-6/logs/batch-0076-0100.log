   317	        candidate_match = LEVEL_DATASET_RE.match(candidate)
   318	        if candidate_match and int(candidate_match.group(1)) <= max_level:
   319	            dataset_ids.append(candidate)
   320	    return dataset_ids or [dataset_id]
