   448	def export_generation_jobs(
   449	    dataset_id: str,
   450	    output_file: str,
   451	    start_rank: int,
   452	    end_rank: int,
   453	    include_existing: bool = False,
   454	) -> None:
   455	    output_path = Path(output_file)
   456	    output_path.parent.mkdir(parents=True, exist_ok=True)
   457	
   458	    with connect() as conn:
   459	        seed_rows = conn.execute(
   460	            """
   461	            SELECT
   462	              s.dataset_id,
   463	              s.rank,
   464	              s.display_form,
   465	              s.pronunciation,
   466	              s.pos,
   467	              s.primary_gloss,
   468	              s.secondary_glosses_json,
   469	              s.notes
   470	            FROM source_translation_seeds s
   471	            WHERE s.dataset_id = ?
   472	              AND s.rank BETWEEN ? AND ?
   473	            ORDER BY s.rank
   474	            """,
   475	            (dataset_id, start_rank, end_rank),
   476	        ).fetchall()
   477	        existing_word_ids = set()
   478	        if not include_existing:
   479	            existing_word_ids = {
   480	                row["id"]
   481	                for row in conn.execute(
   482	                    "SELECT id FROM words WHERE id LIKE ?",
   483	                    (f"{dataset_word_prefix(dataset_id)}-%",),
   484	                ).fetchall()
   485	            }
   486	
   487	    jobs = []
   488	    for row in seed_rows:
   489	        display_form = row["display_form"]
   490	        word_id = build_word_id(row["dataset_id"], row["rank"])
   491	        if not include_existing and word_id in existing_word_ids:
   492	            continue
   493	        jobs.append(
   494	            {
   495	                "dataset_id": row["dataset_id"],
   496	                "word_id": word_id,
   497	                "rank": row["rank"],
   498	                "display_form": display_form,
   499	                "lemma": normalize_display_form(display_form),
   500	                "generation_form": normalize_display_form(display_form),
   501	                "pronunciation": normalize_pronunciation(row["pronunciation"]),
   502	                "pos": row["pos"],
   503	                "primary_gloss": row["primary_gloss"],
   504	                "secondary_glosses": json.loads(row["secondary_glosses_json"]),
   505	                "notes": row["notes"],
   506	            }
   507	        )
   508	
   509	    output_path.write_text(json.dumps(jobs, ensure_ascii=False, indent=2) + "\n")
