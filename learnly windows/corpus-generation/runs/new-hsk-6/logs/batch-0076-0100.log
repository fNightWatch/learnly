   375	def validate_and_count_payload_tokens(payload: dict, conn: sqlite3.Connection) -> list[int]:
   376	    dataset_id = dataset_id_for_word_id(payload["word"]["id"])
   377	    if not dataset_id:
   378	        return []
   379	    lexicon = build_allowed_lexicon(dataset_id, conn)
   380	    token_counts: list[int] = []
   381	    for example in payload["examples"]:
   382	        segmented = segment_with_lexicon(
   383	            clean_sentence_for_segmentation(example["sentence"]),
   384	            lexicon,
   385	        )
   386	        if segmented is None:
   387	            raise ValueError(
   388	                f"{payload['word']['id']}: sentence uses words outside allowed New HSK level set: {example['sentence']}"
   389	            )
   390	        token_counts.append(len(segmented))
   391	    return token_counts
