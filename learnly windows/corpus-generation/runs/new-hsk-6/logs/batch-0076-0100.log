   323	def build_allowed_lexicon(dataset_id: str, conn: sqlite3.Connection) -> set[str]:
   324	    dataset_ids = allowed_dataset_ids_for_level(dataset_id, conn)
   325	    placeholders = ",".join("?" for _ in dataset_ids)
   326	    rows = conn.execute(
   327	        f"SELECT display_form FROM source_translation_seeds WHERE dataset_id IN ({placeholders})",
   328	        dataset_ids,
   329	    ).fetchall()
   330	    lexicon = set()
   331	    for row in rows:
   332	        for variant in display_form_variants(row["display_form"]):
   333	            lexicon.add(variant)
   334	    return lexicon
