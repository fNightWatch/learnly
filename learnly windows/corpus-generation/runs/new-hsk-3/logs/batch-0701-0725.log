{"word": {"id": "new-hsk-3-0720", "lang": "zh", "lemma": "通信", "display_form": "通信", "pos": "unknown", "rank": 720, "pronunciation": "tōng xìn"}, "glosses": {"primary_gloss": "communicate by letter or message", "secondary_glosses": ["correspond", "keep in touch"], "notes": "Used when people communicate from a distance, especially by writing or messaging."}, "examples": [{"id": "new-hsk-3-0720-ex1", "meaning_en": "correspond", "sentence": "爷爷现在还和老朋友通信。", "difficulty": 1, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0720-ex2", "meaning_en": "communicate by letter", "sentence": "以前没有手机的时候，大家常写信通信。", "difficulty": 2, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0720-ex3", "meaning_en": "keep in touch", "sentence": "住得远的时候，我们只能通信。", "difficulty": 2, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0720-ex1", "translation": "Grandpa still corresponds with his old friends."}, {"example_id": "new-hsk-3-0720-ex2", "translation": "Before there were mobile phones, people often communicated by letter."}, {"example_id": "new-hsk-3-0720-ex3", "translation": "When we lived far apart, we could only correspond."}]}
