ranks = {}
for row in conn.execute('SELECT rank, display_form FROM source_translation_seeds'):
    variants = []
    for part in ALT_SEPARATOR_RE.split(row['display_form'].strip()):
        cleaned = ANNOTATION_RE.sub('', part).strip()
        if cleaned and cleaned not in variants:
            variants.append(cleaned)
    for variant in variants or [row['display_form'].strip()]:
        ranks.setdefault(variant, row['rank'])
max_len = max(len(token) for token in lexicon)

def segment(text: str):
    text = clean_sentence_for_segmentation(text)
    @lru_cache(None)
    def dfs(index: int):
        if index == len(text):
            return []
        upper = min(len(text), index + max_len)
        for end in range(upper, index, -1):
            token = text[index:end]
            if token in lexicon:
                rest = dfs(end)
                if rest is not None:
                    return [token] + rest
        return None
    return dfs(0)

