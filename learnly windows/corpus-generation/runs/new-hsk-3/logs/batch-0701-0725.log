{"word": {"id": "new-hsk-3-0725", "lang": "zh", "lemma": "头脑", "display_form": "头脑", "pos": "unknown", "rank": 725, "pronunciation": "tóu nǎo"}, "glosses": {"primary_gloss": "mind; brain", "secondary_glosses": ["way of thinking"], "notes": "Used for the mind, the brain, or how clearly someone thinks."}, "examples": [{"id": "new-hsk-3-0725-ex1", "meaning_en": "mind", "sentence": "你先休息一下，让头脑清楚一点。", "difficulty": 1, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0725-ex2", "meaning_en": "brain", "sentence": "她头脑很清楚，已经想到办法了。", "difficulty": 2, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0725-ex3", "meaning_en": "mind", "sentence": "睡得太晚，第二天头脑不清楚。", "difficulty": 1, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0725-ex1", "translation": "Rest first so your mind can clear up a little."}, {"example_id": "new-hsk-3-0725-ex2", "translation": "She is clear-headed and has already thought of a solution."}, {"example_id": "new-hsk-3-0725-ex3", "translation": "If you sleep too late, your mind will not be clear the next day."}]}
