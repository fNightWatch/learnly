{"word": {"id": "new-hsk-3-0722", "lang": "zh", "lemma": "痛", "display_form": "痛（形）", "pos": "adjective", "rank": 722, "pronunciation": "tòng"}, "glosses": {"primary_gloss": "painful; sore", "secondary_glosses": ["ache", "hurt"], "notes": "Used when a body part hurts or feels sore."}, "examples": [{"id": "new-hsk-3-0722-ex1", "meaning_en": "ache", "sentence": "我的头很痛。", "difficulty": 2, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0722-ex2", "meaning_en": "painful", "sentence": "这只脚走路的时候很痛。", "difficulty": 2, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0722-ex3", "meaning_en": "hurt", "sentence": "这只手一动就痛。", "difficulty": 2, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0722-ex1", "translation": "My head hurts a lot."}, {"example_id": "new-hsk-3-0722-ex2", "translation": "This foot hurts when I walk."}, {"example_id": "new-hsk-3-0722-ex3", "translation": "This hand hurts as soon as it moves."}]}
{"word": {"id": "new-hsk-3-0723", "lang": "zh", "lemma": "痛苦", "display_form": "痛苦", "pos": "unknown", "rank": 723, "pronunciation": "tòngkǔ"}, "glosses": {"primary_gloss": "painful; miserable", "secondary_glosses": ["suffering"], "notes": "Used for strong physical or emotional pain."}, "examples": [{"id": "new-hsk-3-0723-ex1", "meaning_en": "painful", "sentence": "住院的时候，他很痛苦。", "difficulty": 2, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0723-ex2", "meaning_en": "suffering", "sentence": "和家人分开以后，她心里很痛苦。", "difficulty": 2, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0723-ex3", "meaning_en": "miserable", "sentence": "妈妈不在家的时候，孩子很痛苦。", "difficulty": 1, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0723-ex1", "translation": "He was in great pain while he was in the hospital."}, {"example_id": "new-hsk-3-0723-ex2", "translation": "After being separated from her family, she felt deep pain inside."}, {"example_id": "new-hsk-3-0723-ex3", "translation": "When his mother was not at home, the child felt miserable."}]}
{"word": {"id": "new-hsk-3-0724", "lang": "zh", "lemma": "头", "display_form": "头（形）", "pos": "adjective", "rank": 724, "pronunciation": "tóu"}, "glosses": {"primary_gloss": "first; earliest", "secondary_glosses": ["earliest"], "notes": "Used before time or measure words to mean the first or earliest one."}, "examples": [{"id": "new-hsk-3-0724-ex1", "meaning_en": "first", "sentence": "这是我头一次来北京。", "difficulty": 1, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0724-ex2", "meaning_en": "first", "sentence": "头一年学中文的时候，我很紧张。", "difficulty": 1, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0724-ex3", "meaning_en": "earliest", "sentence": "我们坐头班车去机场。", "difficulty": 1, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0724-ex1", "translation": "This is my first time coming to Beijing."}, {"example_id": "new-hsk-3-0724-ex2", "translation": "In my first year of studying Chinese, I was very nervous."}, {"example_id": "new-hsk-3-0724-ex3", "translation": "We took the first bus to the airport."}]}
{"word": {"id": "new-hsk-3-0725", "lang": "zh", "lemma": "头脑", "display_form": "头脑", "pos": "unknown", "rank": 725, "pronunciation": "tóu nǎo"}, "glosses": {"primary_gloss": "mind; brain", "secondary_glosses": ["way of thinking"], "notes": "Used for the mind, the brain, or how clearly someone thinks."}, "examples": [{"id": "new-hsk-3-0725-ex1", "meaning_en": "mind", "sentence": "你先休息一下，让头脑清楚一点。", "difficulty": 1, "source": "generator-3", "is_primary": true}, {"id": "new-hsk-3-0725-ex2", "meaning_en": "brain", "sentence": "她头脑很清楚，已经想到办法了。", "difficulty": 2, "source": "generator-3", "is_primary": false}, {"id": "new-hsk-3-0725-ex3", "meaning_en": "mind", "sentence": "睡得太晚，第二天头脑不清楚。", "difficulty": 1, "source": "generator-3", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-3-0725-ex1", "translation": "Rest first so your mind can clear up a little."}, {"example_id": "new-hsk-3-0725-ex2", "translation": "She is clear-headed and has already thought of a solution."}, {"example_id": "new-hsk-3-0725-ex3", "translation": "If you sleep too late, your mind will not be clear the next day."}]}

