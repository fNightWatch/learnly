import sqlite3, json
from orchestrator import build_allowed_lexicon, clean_sentence_for_segmentation, can_segment_with_lexicon
conn = sqlite3.connect('corpus-hsk-3.sqlite')
conn.row_factory = sqlite3.Row
lexicon = build_allowed_lexicon('new-hsk-3-words', conn)
ranks = {}
for row in conn.execute(\"SELECT dataset_id, rank, display_form FROM source_translation_seeds\"):
    for part in [p.strip() for p in row['display_form'].replace('（','|').split('|')[:1]]:
        pass
for row in conn.execute(\"SELECT dataset_id, rank, display_form FROM source_translation_seeds\"):
    text = row['display_form']
    # duplicate display_form_variants logic without importing private helpers again
    import re
    ALT_SEPARATOR_RE = re.compile(r\"\\s*[｜|/]\\s*\")
    ANNOTATION_RE = re.compile(r\"（["'^）]*）")
    variants = []
    for part in ALT_SEPARATOR_RE.split(text.strip()):
        cleaned = ANNOTATION_RE.sub('"'', part).strip()
        if cleaned and cleaned not in variants:
            variants.append(cleaned)
    for v in variants or [text.strip()]:
        ranks.setdefault(v, row['rank'])

def segment(text):
    text = clean_sentence_for_segmentation(text)
    max_token_length = max((len(token) for token in lexicon), default=0)
    from functools import lru_cache
    @lru_cache(None)
    def dfs(i):
        if i == len(text):
            return []
        upper = min(len(text), i+max_token_length)
        for j in range(upper, i, -1):
            tok = text[i:j]
            if tok in lexicon:
                rest = dfs(j)
                if rest is not None:
                    return [tok] + rest
        return None
    return dfs(0)

