{\"word\":{\"id\":\"new-hsk-3-0763\",\"lang\":\"zh\",\"lemma\":\"文章\",\"display_form\":\"文章\",\"pos\":\"unknown\",\"rank\":763,\"pronunciation\":\"wénzhāng\"},\"glosses\":{\"primary_gloss\":\"article; essay\",\"secondary_glosses\":[],\"notes\":\"A piece of writing such as an article, essay, or short written text.\"},\"examples\":[{\"id\":\"new-hsk-3-0763-ex1\",\"meaning_en\":\"essay\",\"sentence\":\"老师让我们写一篇文章。\",\"translation\":\"The teacher asked us to write an essay.\",\"difficulty\":1,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0763-ex2\",\"meaning_en\":\"article\",\"sentence\":\"这篇文章不长，很容易懂。\",\"translation\":\"This article isn't long and is easy to understand.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0763-ex3\",\"meaning_en\":\"article\",\"sentence\":\"我在网上看到一篇好文章。\",\"translation\":\"I saw a good article online.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0763-ex1\",\"translation\":\"The teacher asked us to write an essay.\"},{\"example_id\":\"new-hsk-3-0763-ex2\",\"translation\":\"This article isn't long and is easy to understand.\"},{\"example_id\":\"new-hsk-3-0763-ex3\",\"translation\":\"I saw a good article online.\"}]},
