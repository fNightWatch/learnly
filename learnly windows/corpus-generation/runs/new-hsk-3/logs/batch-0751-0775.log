{\"word\":{\"id\":\"new-hsk-3-0758\",\"lang\":\"zh\",\"lemma\":\"温暖\",\"display_form\":\"温暖\",\"pos\":\"unknown\",\"rank\":758,\"pronunciation\":\"wēnnuǎn\"},\"glosses\":{\"primary_gloss\":\"warm; comforting\",\"secondary_glosses\":[],\"notes\":\"Describes physical warmth, and it can also describe a warm, comforting feeling.\"},\"examples\":[{\"id\":\"new-hsk-3-0758-ex1\",\"meaning_en\":\"warm\",\"sentence\":\"这件外套很温暖。\",\"translation\":\"This coat is very warm.\",\"difficulty\":1,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0758-ex2\",\"meaning_en\":\"warm\",\"sentence\":\"屋子里开了空调，很温暖。\",\"translation\":\"The air conditioner is on in the room, so it feels warm.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0758-ex3\",\"meaning_en\":\"comforting\",\"sentence\":\"冬天回到家里，热汤让人觉得很温暖。\",\"translation\":\"Coming home in winter, hot soup makes people feel very warm.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0758-ex1\",\"translation\":\"This coat is very warm.\"},{\"example_id\":\"new-hsk-3-0758-ex2\",\"translation\":\"The air conditioner is on in the room, so it feels warm.\"},{\"example_id\":\"new-hsk-3-0758-ex3\",\"translation\":\"Coming home in winter, hot soup makes people feel very warm.\"}]},
{\"word\":{\"id\":\"new-hsk-3-0759\",\"lang\":\"zh\",\"lemma\":\"文化\",\"display_form\":\"文化\",\"pos\":\"unknown\",\"rank\":759,\"pronunciation\":\"wénhuà\"},\"glosses\":{\"primary_gloss\":\"culture\",\"secondary_glosses\":[],\"notes\":\"Refers to the customs, arts, and way of life of a place or group of people.\"},\"examples\":[{\"id\":\"new-hsk-3-0759-ex1\",\"meaning_en\":\"culture\",\"sentence\":\"她很喜欢中国文化。\",\"translation\":\"She likes Chinese culture very much.\",\"difficulty\":1,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0759-ex2\",\"meaning_en\":\"culture\",\"sentence\":\"这个节目在介绍西部文化。\",\"translation\":\"This program is introducing the culture of the western region.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0759-ex3\",\"meaning_en\":\"culture\",\"sentence\":\"到新地方时，我总想知道那里的文化。\",\"translation\":\"When I go to a new place, I always want to know the culture there.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0759-ex1\",\"translation\":\"She likes Chinese culture very much.\"},{\"example_id\":\"new-hsk-3-0759-ex2\",\"translation\":\"This program is introducing the culture of the western region.\"},{\"example_id\":\"new-hsk-3-0759-ex3\",\"translation\":\"When I go to a new place, I always want to know the culture there.\"}]},
