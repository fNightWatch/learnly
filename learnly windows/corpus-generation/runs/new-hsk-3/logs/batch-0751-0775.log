{\"word\":{\"id\":\"new-hsk-3-0765\",\"lang\":\"zh\",\"lemma\":\"握手\",\"display_form\":\"握手\",\"pos\":\"unknown\",\"rank\":765,\"pronunciation\":\"wòshǒu\"},\"glosses\":{\"primary_gloss\":\"shake hands\",\"secondary_glosses\":[\"handshake\"],\"notes\":\"Usually means to shake hands when greeting someone or meeting them.\"},\"examples\":[{\"id\":\"new-hsk-3-0765-ex1\",\"meaning_en\":\"shake hands\",\"sentence\":\"比赛前，两个人先握手。\",\"translation\":\"Before the match, the two people shook hands.\",\"difficulty\":1,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0765-ex2\",\"meaning_en\":\"shake hands\",\"sentence\":\"她进门后先和大家握手。\",\"translation\":\"After she came in, she shook hands with everyone first.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0765-ex3\",\"meaning_en\":\"shake hands\",\"sentence\":\"见到老师时，他笑着跟老师握手。\",\"translation\":\"When he saw the teacher, he smiled and shook the teacher's hand.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0765-ex1\",\"translation\":\"Before the match, the two people shook hands.\"},{\"example_id\":\"new-hsk-3-0765-ex2\",\"translation\":\"After she came in, she shook hands with everyone first.\"},{\"example_id\":\"new-hsk-3-0765-ex3\",\"translation\":\"When he saw the teacher, he smiled and shook the teacher's hand.\"}]},
