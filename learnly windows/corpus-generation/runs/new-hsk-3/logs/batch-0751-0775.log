{\"word\":{\"id\":\"new-hsk-3-0761\",\"lang\":\"zh\",\"lemma\":\"文明\",\"display_form\":\"文明\",\"pos\":\"unknown\",\"rank\":761,\"pronunciation\":\"wénmíng\"},\"glosses\":{\"primary_gloss\":\"civilized; civilization\",\"secondary_glosses\":[\"polite\"],\"notes\":\"Usually describes polite, orderly behavior, and it can also mean civilization in history.\"},\"examples\":[{\"id\":\"new-hsk-3-0761-ex1\",\"meaning_en\":\"civilized\",\"sentence\":\"在图书馆里大声说话不文明。\",\"translation\":\"Speaking loudly in the library is not civilized.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0761-ex2\",\"meaning_en\":\"civilized\",\"sentence\":\"排队上车很文明。\",\"translation\":\"Lining up to get on the bus is civilized.\",\"difficulty\":1,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0761-ex3\",\"meaning_en\":\"civilization\",\"sentence\":\"老师今天给我们讲古代文明。\",\"translation\":\"Today the teacher talked to us about ancient civilization.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0761-ex1\",\"translation\":\"Speaking loudly in the library is not civilized.\"},{\"example_id\":\"new-hsk-3-0761-ex2\",\"translation\":\"Lining up to get on the bus is civilized.\"},{\"example_id\":\"new-hsk-3-0761-ex3\",\"translation\":\"Today the teacher talked to us about ancient civilization.\"}]},
