{\"word\":{\"id\":\"new-hsk-3-0769\",\"lang\":\"zh\",\"lemma\":\"舞台\",\"display_form\":\"舞台\",\"pos\":\"unknown\",\"rank\":769,\"pronunciation\":\"wǔ tái\"},\"glosses\":{\"primary_gloss\":\"stage\",\"secondary_glosses\":[],\"notes\":\"The stage where people perform or appear in front of an audience.\"},\"examples\":[{\"id\":\"new-hsk-3-0769-ex1\",\"meaning_en\":\"stage\",\"sentence\":\"她第一次上舞台，很紧张。\",\"translation\":\"It was her first time on stage, so she was very nervous.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":True},{\"id\":\"new-hsk-3-0769-ex2\",\"meaning_en\":\"stage\",\"sentence\":\"演出前，演员都在舞台后面等。\",\"translation\":\"Before the show, the performers were all waiting behind the stage.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False},{\"id\":\"new-hsk-3-0769-ex3\",\"meaning_en\":\"stage\",\"sentence\":\"音乐一响，大家都看着舞台。\",\"translation\":\"As soon as the music started, everyone looked at the stage.\",\"difficulty\":2,\"source\":\"generator-3\",\"is_primary\":False}],\"example_translations\":[{\"example_id\":\"new-hsk-3-0769-ex1\",\"translation\":\"It was her first time on stage, so she was very nervous.\"},{\"example_id\":\"new-hsk-3-0769-ex2\",\"translation\":\"Before the show, the performers were all waiting behind the stage.\"},{\"example_id\":\"new-hsk-3-0769-ex3\",\"translation\":\"As soon as the music started, everyone looked at the stage.\"}]},
