import sqlite3, re
DB='corpus-hsk-3.sqlite'
CHINESE_PUNCT_RE = re.compile(r\"[，。！？；：、“”‘’（）《》〈〉【】—…·\\s,."'!?;:'"\\\"'()\\[\\]{}-]+\")
ALT_SEPARATOR_RE = re.compile(r\"\\s*[｜|/]\\s*\")
ANNOTATION_RE = re.compile(r\"（["'^）]*）")
LEVEL_DATASET_RE = re.compile(r"''^new-hsk-('"\\d+)-words"'$")

def display_form_variants(display_form):
    out=[]
    for part in ALT_SEPARATOR_RE.split(display_form.strip()):
        cleaned=ANNOTATION_RE.sub('"'', part).strip()
        if cleaned and cleaned not in out:
            out.append(cleaned)
    return out or [display_form.strip()]

def allowed(dataset_id, conn):
    m=LEVEL_DATASET_RE.match(dataset_id)
    ids=[]
    if m:
        level=int(m.group(1))
        for (cand,) in conn.execute('SELECT dataset_id FROM source_datasets ORDER BY dataset_id'):
            m2=LEVEL_DATASET_RE.match(cand)
            if m2 and int(m2.group(1))<=level:
                ids.append(cand)
    else:
        ids=[dataset_id]
    rows=conn.execute(f\"SELECT display_form FROM source_translation_seeds WHERE dataset_id IN ({','.join('?' for _ in ids)})\", ids)
    lex=set()
    for (df,) in rows:
        lex.update(display_form_variants(df))
    return lex

def seg(text, lex):
    text=CHINESE_PUNCT_RE.sub('', text)
    M=max(map(len, lex))
    memo={}
    def dfs(i):
        if i==len(text): return []
        if i in memo: return memo[i]
        for j in range(min(len(text), i+M), i, -1):
            tok=text[i:j]
            if tok in lex:
                rest=dfs(j)
                if rest is not None:
                    memo[i]=[tok]+rest
                    return memo[i]
        memo[i]=None
        return None
    return dfs(0)
conn=sqlite3.connect(DB)
lex=allowed('new-hsk-3-words', conn)
tests=[
'这个市场晚上也开门。',
'我家前面有一个市场。',
'大家都知道这个事实。',
'这张票今天适用。',
'这个办法现在不适用。',
'这条规定在这里适用。',
'她的手指很长。',
'我的手指有点儿疼。',
'医生看了看我的手指。',
]
for s in tests:
    print(s, '=>', seg(s, lex))
