{"word":{"id":"new-hsk-3-0651","lang":"zh","lemma":"始终","display_form":"始终","pos":"unknown","rank":651,"pronunciation":"shǐzhōng"},"glosses":{"primary_gloss":"all along","secondary_glosses":["throughout","the whole time"],"notes":"Adverb meaning all the time or from beginning to end."},"examples":[{"id":"new-hsk-3-0651-ex1","meaning_en":"the whole time","sentence":"他始终站在门口等我。","translation":"He stood at the door waiting for me the whole time.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0651-ex2","meaning_en":"all along","sentence":"妈妈始终觉得这件衣服太大。","translation":"Mom has thought all along that this piece of clothing is too big.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0651-ex3","meaning_en":"throughout","sentence":"电影开始以后，他始终看着门。","translation":"After the movie started, he kept looking at the door.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0651-ex1","translation":"He stood at the door waiting for me the whole time."},{"example_id":"new-hsk-3-0651-ex2","translation":"Mom has thought all along that this piece of clothing is too big."},{"example_id":"new-hsk-3-0651-ex3","translation":"After the movie started, he kept looking at the door."}]}
{"word":{"id":"new-hsk-3-0652","lang":"zh","lemma":"世纪","display_form":"世纪","pos":"unknown","rank":652,"pronunciation":"shìjì"},"glosses":{"primary_gloss":"century","secondary_glosses":[],"notes":"Noun for a period of one hundred years, often used in dates like the twentieth century."},"examples":[{"id":"new-hsk-3-0652-ex1","meaning_en":"century","sentence":"我爷爷出生在上个世纪。","translation":"My grandpa was born in the last century.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0652-ex2","meaning_en":"century","sentence":"这个故事发生在二十世纪。","translation":"This story happened in the twentieth century.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0652-ex3","meaning_en":"century","sentence":"二十一世纪，很多人用手机工作。","translation":"In the twenty-first century, many people use phones for work.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0652-ex1","translation":"My grandpa was born in the last century."},{"example_id":"new-hsk-3-0652-ex2","translation":"This story happened in the twentieth century."},{"example_id":"new-hsk-3-0652-ex3","translation":"In the twenty-first century, many people use phones for work."}]}
{"word":{"id":"new-hsk-3-0653","lang":"zh","lemma":"世界","display_form":"世界","pos":"unknown","rank":653,"pronunciation":"shìjiè"},"glosses":{"primary_gloss":"world","secondary_glosses":[],"notes":"The world as the whole earth or all the countries and people on it."},"examples":[{"id":"new-hsk-3-0653-ex1","meaning_en":"world","sentence":"孩子想看看世界地图。","translation":"The child wants to look at a world map.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0653-ex2","meaning_en":"world","sentence":"他觉得世界很大，想出去看看。","translation":"He feels the world is big and wants to go out and see it.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0653-ex3","meaning_en":"world","sentence":"世界上有很多不同的国家。","translation":"There are many different countries in the world.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0653-ex1","translation":"The child wants to look at a world map."},{"example_id":"new-hsk-3-0653-ex2","translation":"He feels the world is big and wants to go out and see it."},{"example_id":"new-hsk-3-0653-ex3","translation":"There are many different countries in the world."}]}
{"word":{"id":"new-hsk-3-0654","lang":"zh","lemma":"世界杯","display_form":"世界杯","pos":"unknown","rank":654,"pronunciation":"shì jiè bēi"},"glosses":{"primary_gloss":"World Cup","secondary_glosses":[],"notes":"Usually refers to the football World Cup."},"examples":[{"id":"new-hsk-3-0654-ex1","meaning_en":"World Cup","sentence":"爸爸晚上看世界杯比赛。","translation":"Dad watches World Cup matches in the evening.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0654-ex2","meaning_en":"World Cup","sentence":"世界杯开始以后，店里人很多。","translation":"After the World Cup started, the shop was full of people.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0654-ex3","meaning_en":"World Cup","sentence":"我想和朋友一起看世界杯。","translation":"I want to watch the World Cup with my friends.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0654-ex1","translation":"Dad watches World Cup matches in the evening."},{"example_id":"new-hsk-3-0654-ex2","translation":"After the World Cup started, the shop was full of people."},{"example_id":"new-hsk-3-0654-ex3","translation":"I want to watch the World Cup with my friends."}]}
{"word":{"id":"new-hsk-3-0655","lang":"zh","lemma":"市场","display_form":"市场","pos":"unknown","rank":655,"pronunciation":"shìchǎng"},"glosses":{"primary_gloss":"market","secondary_glosses":["marketplace"],"notes":"Can mean a place where people buy and sell things, and also the market for a product."},"examples":[{"id":"new-hsk-3-0655-ex1","meaning_en":"market","sentence":"妈妈早上去市场买菜。","translation":"Mom goes to the market in the morning to buy vegetables.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0655-ex2","meaning_en":"market","sentence":"这个市场晚上也开门。","translation":"This market is open at night too.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0655-ex3","meaning_en":"market","sentence":"我家前面有一个市场。","translation":"There is a market in front of my home.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0655-ex1","translation":"Mom goes to the market in the morning to buy vegetables."},{"example_id":"new-hsk-3-0655-ex2","translation":"This market is open at night too."},{"example_id":"new-hsk-3-0655-ex3","translation":"There is a market in front of my home."}]}
{"word":{"id":"new-hsk-3-0656","lang":"zh","lemma":"事故","display_form":"事故","pos":"unknown","rank":656,"pronunciation":"shìgù"},"glosses":{"primary_gloss":"accident","secondary_glosses":["incident"],"notes":"Usually an unexpected bad event such as a traffic accident."},"examples":[{"id":"new-hsk-3-0656-ex1","meaning_en":"accident","sentence":"前面有事故，我们得下车走。","translation":"There is an accident ahead, so we have to get out and walk.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0656-ex2","meaning_en":"accident","sentence":"路上出了小事故，所以车很慢。","translation":"There was a small accident on the road, so the cars are moving slowly.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0656-ex3","meaning_en":"accident","sentence":"新闻里说今天早上有事故。","translation":"The news said there was an accident this morning.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0656-ex1","translation":"There is an accident ahead, so we have to get out and walk."},{"example_id":"new-hsk-3-0656-ex2","translation":"There was a small accident on the road, so the cars are moving slowly."},{"example_id":"new-hsk-3-0656-ex3","translation":"The news said there was an accident this morning."}]}
{"word":{"id":"new-hsk-3-0657","lang":"zh","lemma":"事件","display_form":"事件","pos":"unknown","rank":657,"pronunciation":"shìjiàn"},"glosses":{"primary_gloss":"incident","secondary_glosses":["event"],"notes":"A formal noun for a notable event or incident."},"examples":[{"id":"new-hsk-3-0657-ex1","meaning_en":"incident","sentence":"这次事件发生在学校门口。","translation":"This incident happened at the school gate.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0657-ex2","meaning_en":"incident","sentence":"新闻里在说昨天的事件。","translation":"The news is talking about yesterday's incident.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0657-ex3","meaning_en":"incident","sentence":"老师请大家不要再谈那个事件。","translation":"The teacher asked everyone not to talk about that incident anymore.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0657-ex1","translation":"This incident happened at the school gate."},{"example_id":"new-hsk-3-0657-ex2","translation":"The news is talking about yesterday's incident."},{"example_id":"new-hsk-3-0657-ex3","translation":"The teacher asked everyone not to talk about that incident anymore."}]}
{"word":{"id":"new-hsk-3-0658","lang":"zh","lemma":"事实","display_form":"事实","pos":"unknown","rank":658,"pronunciation":"shìshí"},"glosses":{"primary_gloss":"fact","secondary_glosses":["truth"],"notes":"What is really true in a situation."},"examples":[{"id":"new-hsk-3-0658-ex1","meaning_en":"fact","sentence":"杯子是他打坏的，这是事实。","translation":"It is a fact that he broke the cup.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0658-ex2","meaning_en":"fact","sentence":"她没来上课，这是一个事实。","translation":"It is a fact that she did not come to class.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0658-ex3","meaning_en":"fact","sentence":"大家都知道这个事实。","translation":"Everyone knows this fact.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0658-ex1","translation":"It is a fact that he broke the cup."},{"example_id":"new-hsk-3-0658-ex2","translation":"It is a fact that she did not come to class."},{"example_id":"new-hsk-3-0658-ex3","translation":"Everyone knows this fact."}]}
{"word":{"id":"new-hsk-3-0659","lang":"zh","lemma":"事实上","display_form":"事实上","pos":"unknown","rank":659,"pronunciation":"shì shí shàng"},"glosses":{"primary_gloss":"in fact","secondary_glosses":["actually"],"notes":"Adverb used to correct or clarify what is really true."},"examples":[{"id":"new-hsk-3-0659-ex1","meaning_en":"in fact","sentence":"我以为她在家，事实上她在公司。","translation":"I thought she was at home, but in fact she was at the office.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0659-ex2","meaning_en":"in fact","sentence":"这件衣服不贵，事实上很便宜。","translation":"This piece of clothing is not expensive; in fact, it is quite cheap.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0659-ex3","meaning_en":"actually","sentence":"我以为今天会下雨，事实上天气很好。","translation":"I thought it would rain today, but actually the weather is very nice.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0659-ex1","translation":"I thought she was at home, but in fact she was at the office."},{"example_id":"new-hsk-3-0659-ex2","translation":"This piece of clothing is not expensive; in fact, it is quite cheap."},{"example_id":"new-hsk-3-0659-ex3","translation":"I thought it would rain today, but actually the weather is very nice."}]}
{"word":{"id":"new-hsk-3-0660","lang":"zh","lemma":"事业","display_form":"事业","pos":"unknown","rank":660,"pronunciation":"shìyè"},"glosses":{"primary_gloss":"career","secondary_glosses":["cause"],"notes":"Usually means a person's career, and it can also mean a cause or undertaking."},"examples":[{"id":"new-hsk-3-0660-ex1","meaning_en":"career","sentence":"她想先有自己的事业，再结婚。","translation":"She wants to have a career of her own before getting married.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0660-ex2","meaning_en":"career","sentence":"回国以后，他开始新的事业。","translation":"After returning to his country, he started a new career.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0660-ex3","meaning_en":"career","sentence":"为了事业，他搬到首都工作。","translation":"For his career, he moved to the capital to work.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0660-ex1","translation":"She wants to have a career of her own before getting married."},{"example_id":"new-hsk-3-0660-ex2","translation":"After returning to his country, he started a new career."},{"example_id":"new-hsk-3-0660-ex3","translation":"For his career, he moved to the capital to work."}]}
{"word":{"id":"new-hsk-3-0661","lang":"zh","lemma":"试题","display_form":"试题","pos":"unknown","rank":661,"pronunciation":"shì tí"},"glosses":{"primary_gloss":"test question","secondary_glosses":["exam question"],"notes":"A question or set of questions on a test."},"examples":[{"id":"new-hsk-3-0661-ex1","meaning_en":"test question","sentence":"老师把试题发给大家。","translation":"The teacher handed out the test questions to everyone.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0661-ex2","meaning_en":"test question","sentence":"今天的试题不太难。","translation":"Today's test questions are not too hard.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0661-ex3","meaning_en":"test question","sentence":"我先做完前面的试题。","translation":"I will finish the earlier test questions first.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0661-ex1","translation":"The teacher handed out the test questions to everyone."},{"example_id":"new-hsk-3-0661-ex2","translation":"Today's test questions are not too hard."},{"example_id":"new-hsk-3-0661-ex3","translation":"I will finish the earlier test questions first."}]}
{"word":{"id":"new-hsk-3-0662","lang":"zh","lemma":"试验","display_form":"试验","pos":"unknown","rank":662,"pronunciation":"shìyàn"},"glosses":{"primary_gloss":"experiment","secondary_glosses":["test"],"notes":"Can mean an experiment or a practical test."},"examples":[{"id":"new-hsk-3-0662-ex1","meaning_en":"experiment","sentence":"老师今天要做一个小试验。","translation":"The teacher is going to do a small experiment today.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0662-ex2","meaning_en":"experiment","sentence":"这个试验要用很多水。","translation":"This experiment needs a lot of water.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0662-ex3","meaning_en":"experiment","sentence":"做完试验以后，大家都笑了。","translation":"After finishing the experiment, everyone laughed.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0662-ex1","translation":"The teacher is going to do a small experiment today."},{"example_id":"new-hsk-3-0662-ex2","translation":"This experiment needs a lot of water."},{"example_id":"new-hsk-3-0662-ex3","translation":"After finishing the experiment, everyone laughed."}]}
{"word":{"id":"new-hsk-3-0663","lang":"zh","lemma":"适合","display_form":"适合","pos":"unknown","rank":663,"pronunciation":"shìhé"},"glosses":{"primary_gloss":"suit","secondary_glosses":["fit","be suitable for"],"notes":"Verb meaning to be right for a person, thing, or situation."},"examples":[{"id":"new-hsk-3-0663-ex1","meaning_en":"suit","sentence":"这件衣服很适合你。","translation":"This piece of clothing suits you very well.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0663-ex2","meaning_en":"be suitable for","sentence":"这个时间适合开会吗？","translation":"Is this time suitable for a meeting?","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0663-ex3","meaning_en":"fit","sentence":"这里不适合放自行车。","translation":"This place is not suitable for parking bicycles.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0663-ex1","translation":"This piece of clothing suits you very well."},{"example_id":"new-hsk-3-0663-ex2","translation":"Is this time suitable for a meeting?"},{"example_id":"new-hsk-3-0663-ex3","translation":"This place is not suitable for parking bicycles."}]}
{"word":{"id":"new-hsk-3-0664","lang":"zh","lemma":"适应","display_form":"适应","pos":"unknown","rank":664,"pronunciation":"shìyìng"},"glosses":{"primary_gloss":"adapt to","secondary_glosses":["get used to"],"notes":"Verb meaning to become used to a new person, place, or situation."},"examples":[{"id":"new-hsk-3-0664-ex1","meaning_en":"adapt to","sentence":"她刚来北京，还在适应这里的天气。","translation":"She has just come to Beijing and is still adapting to the weather here.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0664-ex2","meaning_en":"get used to","sentence":"我换了新工作，还没适应。","translation":"I changed to a new job and still have not gotten used to it.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0664-ex3","meaning_en":"adapt to","sentence":"孩子很快就适应了学校生活。","translation":"The child adapted to school life very quickly.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0664-ex1","translation":"She has just come to Beijing and is still adapting to the weather here."},{"example_id":"new-hsk-3-0664-ex2","translation":"I changed to a new job and still have not gotten used to it."},{"example_id":"new-hsk-3-0664-ex3","translation":"The child adapted to school life very quickly."}]}
{"word":{"id":"new-hsk-3-0665","lang":"zh","lemma":"适用","display_form":"适用","pos":"unknown","rank":665,"pronunciation":"shì yòng"},"glosses":{"primary_gloss":"apply to","secondary_glosses":["be valid for","be suitable for use"],"notes":"Often used for rules, tickets, medicines, or methods that are valid in a certain case."},"examples":[{"id":"new-hsk-3-0665-ex1","meaning_en":"be valid for","sentence":"这张票今天适用。","translation":"This ticket is valid today.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0665-ex2","meaning_en":"apply to","sentence":"这个办法现在不适用。","translation":"This method does not apply now.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0665-ex3","meaning_en":"apply to","sentence":"这条规定在这里适用。","translation":"This rule applies here.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0665-ex1","translation":"This ticket is valid today."},{"example_id":"new-hsk-3-0665-ex2","translation":"This method does not apply now."},{"example_id":"new-hsk-3-0665-ex3","translation":"This rule applies here."}]}
{"word":{"id":"new-hsk-3-0666","lang":"zh","lemma":"室","display_form":"室","pos":"unknown","rank":666,"pronunciation":"shì"},"glosses":{"primary_gloss":"room","secondary_glosses":["chamber"],"notes":"Usually appears as the second part of words for rooms, such as 办公室 and 会议室."},"examples":[{"id":"new-hsk-3-0666-ex1","meaning_en":"room","sentence":"我去办公室找老师。","translation":"I am going to the office to find the teacher.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0666-ex2","meaning_en":"room","sentence":"会议室里已经有人了。","translation":"There is already someone in the meeting room.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0666-ex3","meaning_en":"room","sentence":"教室和办公室都在二楼。","translation":"The classroom and the office are both on the second floor.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0666-ex1","translation":"I am going to the office to find the teacher."},{"example_id":"new-hsk-3-0666-ex2","translation":"There is already someone in the meeting room."},{"example_id":"new-hsk-3-0666-ex3","translation":"The classroom and the office are both on the second floor."}]}
