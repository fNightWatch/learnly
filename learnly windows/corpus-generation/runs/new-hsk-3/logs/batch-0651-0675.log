import sqlite3, json, re
from pathlib import Path

DB='corpus-hsk-3.sqlite'
CHINESE_PUNCT_RE = re.compile(r\"[，。！？；：、“”‘’（）《》〈〉【】—…·\\s,."'!?;:'"\\\"'()\\[\\]{}-]+\")
ALT_SEPARATOR_RE = re.compile(r\"\\s*[｜|/]\\s*\")
ANNOTATION_RE = re.compile(r\"（["'^）]*）")
LEVEL_DATASET_RE = re.compile(r"''^new-hsk-('"\\d+)-words"'$")

def display_form_variants(display_form: str) -> list[str]:
    variants = []
    for part in ALT_SEPARATOR_RE.split(display_form.strip()):
        cleaned = ANNOTATION_RE.sub("", part).strip()
        if cleaned and cleaned not in variants:
            variants.append(cleaned)
    return variants or [display_form.strip()]

def allowed_dataset_ids_for_level(dataset_id: str, conn):
    match = LEVEL_DATASET_RE.match(dataset_id)
    if not match:
        return [dataset_id]
    max_level = int(match.group(1))
    dataset_ids = []
    for row in conn.execute("SELECT dataset_id FROM source_datasets ORDER BY dataset_id"):
        candidate = row[0]
        m = LEVEL_DATASET_RE.match(candidate)
        if m and int(m.group(1)) <= max_level:
            dataset_ids.append(candidate)
    return dataset_ids or [dataset_id]

def build_allowed_lexicon(dataset_id: str, conn):
    dataset_ids = allowed_dataset_ids_for_level(dataset_id, conn)
    placeholders = '"','.join('?' for _ in dataset_ids)
    rows = conn.execute(f\"SELECT display_form FROM source_translation_seeds WHERE dataset_id IN ({placeholders})\", dataset_ids).fetchall()
    lexicon = set()
    for (display_form,) in rows:
        for variant in display_form_variants(display_form):
            lexicon.add(variant)
    return lexicon

def clean_sentence(sentence: str) -> str:
    return CHINESE_PUNCT_RE.sub('', sentence)

def segment(text: str, lexicon: set[str]):
    max_len = max((len(t) for t in lexicon), default=0)
    memo = {}
    def dfs(i):
        if i == len(text):
            return []
        if i in memo:
            return memo[i]
        upper = min(len(text), i + max_len)
        for end in range(upper, i, -1):
            tok = text[i:end]
            if tok in lexicon:
                rest = dfs(end)
                if rest is not None:
                    memo[i] = [tok] + rest
                    return memo[i]
        memo[i] = None
        return None
    return dfs(0)

