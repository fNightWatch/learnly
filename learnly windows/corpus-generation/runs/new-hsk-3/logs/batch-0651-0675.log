{"word":{"id":"new-hsk-3-0654","lang":"zh","lemma":"世界杯","display_form":"世界杯","pos":"unknown","rank":654,"pronunciation":"shì jiè bēi"},"glosses":{"primary_gloss":"World Cup","secondary_glosses":[],"notes":"Usually refers to the football World Cup."},"examples":[{"id":"new-hsk-3-0654-ex1","meaning_en":"World Cup","sentence":"爸爸晚上看世界杯比赛。","translation":"Dad watches World Cup matches in the evening.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0654-ex2","meaning_en":"World Cup","sentence":"世界杯开始以后，店里人很多。","translation":"After the World Cup started, the shop was full of people.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0654-ex3","meaning_en":"World Cup","sentence":"我想和朋友一起看世界杯。","translation":"I want to watch the World Cup with my friends.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0654-ex1","translation":"Dad watches World Cup matches in the evening."},{"example_id":"new-hsk-3-0654-ex2","translation":"After the World Cup started, the shop was full of people."},{"example_id":"new-hsk-3-0654-ex3","translation":"I want to watch the World Cup with my friends."}]}
{"word":{"id":"new-hsk-3-0655","lang":"zh","lemma":"市场","display_form":"市场","pos":"unknown","rank":655,"pronunciation":"shìchǎng"},"glosses":{"primary_gloss":"market","secondary_glosses":["marketplace"],"notes":"Can mean a place where people buy and sell things, and also the market for a product."},"examples":[{"id":"new-hsk-3-0655-ex1","meaning_en":"market","sentence":"妈妈早上去市场买菜。","translation":"Mom goes to the market in the morning to buy vegetables.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0655-ex2","meaning_en":"market","sentence":"这个市场晚上也开门。","translation":"This market is open at night too.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0655-ex3","meaning_en":"market","sentence":"我家前面有一个市场。","translation":"There is a market in front of my home.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0655-ex1","translation":"Mom goes to the market in the morning to buy vegetables."},{"example_id":"new-hsk-3-0655-ex2","translation":"This market is open at night too."},{"example_id":"new-hsk-3-0655-ex3","translation":"There is a market in front of my home."}]}
{"word":{"id":"new-hsk-3-0656","lang":"zh","lemma":"事故","display_form":"事故","pos":"unknown","rank":656,"pronunciation":"shìgù"},"glosses":{"primary_gloss":"accident","secondary_glosses":["incident"],"notes":"Usually an unexpected bad event such as a traffic accident."},"examples":[{"id":"new-hsk-3-0656-ex1","meaning_en":"accident","sentence":"前面有事故，我们得下车走。","translation":"There is an accident ahead, so we have to get out and walk.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0656-ex2","meaning_en":"accident","sentence":"路上出了小事故，所以车很慢。","translation":"There was a small accident on the road, so the cars are moving slowly.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0656-ex3","meaning_en":"accident","sentence":"新闻里说今天早上有事故。","translation":"The news said there was an accident this morning.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0656-ex1","translation":"There is an accident ahead, so we have to get out and walk."},{"example_id":"new-hsk-3-0656-ex2","translation":"There was a small accident on the road, so the cars are moving slowly."},{"example_id":"new-hsk-3-0656-ex3","translation":"The news said there was an accident this morning."}]}
