{"word":{"id":"new-hsk-3-0653","lang":"zh","lemma":"世界","display_form":"世界","pos":"unknown","rank":653,"pronunciation":"shìjiè"},"glosses":{"primary_gloss":"world","secondary_glosses":[],"notes":"The world as the whole earth or all the countries and people on it."},"examples":[{"id":"new-hsk-3-0653-ex1","meaning_en":"world","sentence":"孩子想看看世界地图。","translation":"The child wants to look at a world map.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0653-ex2","meaning_en":"world","sentence":"他觉得世界很大，想出去看看。","translation":"He feels the world is big and wants to go out and see it.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0653-ex3","meaning_en":"world","sentence":"世界上有很多不同的国家。","translation":"There are many different countries in the world.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0653-ex1","translation":"The child wants to look at a world map."},{"example_id":"new-hsk-3-0653-ex2","translation":"He feels the world is big and wants to go out and see it."},{"example_id":"new-hsk-3-0653-ex3","translation":"There are many different countries in the world."}]}
{"word":{"id":"new-hsk-3-0654","lang":"zh","lemma":"世界杯","display_form":"世界杯","pos":"unknown","rank":654,"pronunciation":"shì jiè bēi"},"glosses":{"primary_gloss":"World Cup","secondary_glosses":[],"notes":"Usually refers to the football World Cup."},"examples":[{"id":"new-hsk-3-0654-ex1","meaning_en":"World Cup","sentence":"爸爸晚上看世界杯比赛。","translation":"Dad watches World Cup matches in the evening.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0654-ex2","meaning_en":"World Cup","sentence":"世界杯开始以后，店里人很多。","translation":"After the World Cup started, the shop was full of people.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0654-ex3","meaning_en":"World Cup","sentence":"我想和朋友一起看世界杯。","translation":"I want to watch the World Cup with my friends.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0654-ex1","translation":"Dad watches World Cup matches in the evening."},{"example_id":"new-hsk-3-0654-ex2","translation":"After the World Cup started, the shop was full of people."},{"example_id":"new-hsk-3-0654-ex3","translation":"I want to watch the World Cup with my friends."}]}
{"word":{"id":"new-hsk-3-0655","lang":"zh","lemma":"市场","display_form":"市场","pos":"unknown","rank":655,"pronunciation":"shìchǎng"},"glosses":{"primary_gloss":"market","secondary_glosses":["marketplace"],"notes":"Can mean a place where people buy and sell things, and also the market for a product."},"examples":[{"id":"new-hsk-3-0655-ex1","meaning_en":"market","sentence":"妈妈早上去市场买菜。","translation":"Mom goes to the market in the morning to buy vegetables.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0655-ex2","meaning_en":"market","sentence":"这个市场晚上也开门。","translation":"This market is open at night too.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0655-ex3","meaning_en":"market","sentence":"我家前面有一个市场。","translation":"There is a market in front of my home.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0655-ex1","translation":"Mom goes to the market in the morning to buy vegetables."},{"example_id":"new-hsk-3-0655-ex2","translation":"This market is open at night too."},{"example_id":"new-hsk-3-0655-ex3","translation":"There is a market in front of my home."}]}
{"word":{"id":"new-hsk-3-0656","lang":"zh","lemma":"事故","display_form":"事故","pos":"unknown","rank":656,"pronunciation":"shìgù"},"glosses":{"primary_gloss":"accident","secondary_glosses":["incident"],"notes":"Usually an unexpected bad event such as a traffic accident."},"examples":[{"id":"new-hsk-3-0656-ex1","meaning_en":"accident","sentence":"前面有事故，我们得下车走。","translation":"There is an accident ahead, so we have to get out and walk.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0656-ex2","meaning_en":"accident","sentence":"路上出了小事故，所以车很慢。","translation":"There was a small accident on the road, so the cars are moving slowly.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0656-ex3","meaning_en":"accident","sentence":"新闻里说今天早上有事故。","translation":"The news said there was an accident this morning.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0656-ex1","translation":"There is an accident ahead, so we have to get out and walk."},{"example_id":"new-hsk-3-0656-ex2","translation":"There was a small accident on the road, so the cars are moving slowly."},{"example_id":"new-hsk-3-0656-ex3","translation":"The news said there was an accident this morning."}]}
{"word":{"id":"new-hsk-3-0657","lang":"zh","lemma":"事件","display_form":"事件","pos":"unknown","rank":657,"pronunciation":"shìjiàn"},"glosses":{"primary_gloss":"incident","secondary_glosses":["event"],"notes":"A formal noun for a notable event or incident."},"examples":[{"id":"new-hsk-3-0657-ex1","meaning_en":"incident","sentence":"这次事件发生在学校门口。","translation":"This incident happened at the school gate.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0657-ex2","meaning_en":"incident","sentence":"新闻里在说昨天的事件。","translation":"The news is talking about yesterday's incident.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0657-ex3","meaning_en":"incident","sentence":"老师请大家不要再谈那个事件。","translation":"The teacher asked everyone not to talk about that incident anymore.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0657-ex1","translation":"This incident happened at the school gate."},{"example_id":"new-hsk-3-0657-ex2","translation":"The news is talking about yesterday's incident."},{"example_id":"new-hsk-3-0657-ex3","translation":"The teacher asked everyone not to talk about that incident anymore."}]}
{"word":{"id":"new-hsk-3-0658","lang":"zh","lemma":"事实","display_form":"事实","pos":"unknown","rank":658,"pronunciation":"shìshí"},"glosses":{"primary_gloss":"fact","secondary_glosses":["truth"],"notes":"What is really true in a situation."},"examples":[{"id":"new-hsk-3-0658-ex1","meaning_en":"fact","sentence":"杯子是他打坏的，这是事实。","translation":"It is a fact that he broke the cup.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0658-ex2","meaning_en":"fact","sentence":"她没来上课，这是一个事实。","translation":"It is a fact that she did not come to class.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0658-ex3","meaning_en":"fact","sentence":"大家都知道这个事实。","translation":"Everyone knows this fact.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0658-ex1","translation":"It is a fact that he broke the cup."},{"example_id":"new-hsk-3-0658-ex2","translation":"It is a fact that she did not come to class."},{"example_id":"new-hsk-3-0658-ex3","translation":"Everyone knows this fact."}]}
{"word":{"id":"new-hsk-3-0659","lang":"zh","lemma":"事实上","display_form":"事实上","pos":"unknown","rank":659,"pronunciation":"shì shí shàng"},"glosses":{"primary_gloss":"in fact","secondary_glosses":["actually"],"notes":"Adverb used to correct or clarify what is really true."},"examples":[{"id":"new-hsk-3-0659-ex1","meaning_en":"in fact","sentence":"我以为她在家，事实上她在公司。","translation":"I thought she was at home, but in fact she was at the office.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0659-ex2","meaning_en":"in fact","sentence":"这件衣服不贵，事实上很便宜。","translation":"This piece of clothing is not expensive; in fact, it is quite cheap.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0659-ex3","meaning_en":"actually","sentence":"我以为今天会下雨，事实上天气很好。","translation":"I thought it would rain today, but actually the weather is very nice.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0659-ex1","translation":"I thought she was at home, but in fact she was at the office."},{"example_id":"new-hsk-3-0659-ex2","translation":"This piece of clothing is not expensive; in fact, it is quite cheap."},{"example_id":"new-hsk-3-0659-ex3","translation":"I thought it would rain today, but actually the weather is very nice."}]}
