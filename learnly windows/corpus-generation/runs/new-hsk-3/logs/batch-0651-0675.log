{"word":{"id":"new-hsk-3-0651","lang":"zh","lemma":"始终","display_form":"始终","pos":"unknown","rank":651,"pronunciation":"shǐzhōng"},"glosses":{"primary_gloss":"all along","secondary_glosses":["throughout","the whole time"],"notes":"Adverb meaning all the time or from beginning to end."},"examples":[{"id":"new-hsk-3-0651-ex1","meaning_en":"the whole time","sentence":"他始终站在门口等我。","translation":"He stood at the door waiting for me the whole time.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0651-ex2","meaning_en":"all along","sentence":"妈妈始终觉得这件衣服太大。","translation":"Mom has thought all along that this piece of clothing is too big.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0651-ex3","meaning_en":"throughout","sentence":"电影开始以后，他始终看着门。","translation":"After the movie started, he kept looking at the door.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0651-ex1","translation":"He stood at the door waiting for me the whole time."},{"example_id":"new-hsk-3-0651-ex2","translation":"Mom has thought all along that this piece of clothing is too big."},{"example_id":"new-hsk-3-0651-ex3","translation":"After the movie started, he kept looking at the door."}]}
{"word":{"id":"new-hsk-3-0652","lang":"zh","lemma":"世纪","display_form":"世纪","pos":"unknown","rank":652,"pronunciation":"shìjì"},"glosses":{"primary_gloss":"century","secondary_glosses":[],"notes":"Noun for a period of one hundred years, often used in dates like the twentieth century."},"examples":[{"id":"new-hsk-3-0652-ex1","meaning_en":"century","sentence":"我爷爷出生在上个世纪。","translation":"My grandpa was born in the last century.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0652-ex2","meaning_en":"century","sentence":"这个故事发生在二十世纪。","translation":"This story happened in the twentieth century.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0652-ex3","meaning_en":"century","sentence":"二十一世纪，很多人用手机工作。","translation":"In the twenty-first century, many people use phones for work.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0652-ex1","translation":"My grandpa was born in the last century."},{"example_id":"new-hsk-3-0652-ex2","translation":"This story happened in the twentieth century."},{"example_id":"new-hsk-3-0652-ex3","translation":"In the twenty-first century, many people use phones for work."}]}
