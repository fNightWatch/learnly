+{"word":{"id":"new-hsk-3-0674","lang":"zh","lemma":"首先","display_form":"首先","pos":"unknown","rank":674,"pronunciation":"shǒuxiān"},"glosses":{"primary_gloss":"first","secondary_glosses":["first of all"],"notes":"Adverb used to say what comes before the other steps or points."},"examples":[{"id":"new-hsk-3-0674-ex1","meaning_en":"first","sentence":"做这道题的时候，首先看问题。","translation":"When doing this question, first look at the problem.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0674-ex2","meaning_en":"first of all","sentence":"到了饭店，我们首先看菜单。","translation":"When we arrive at the restaurant, we first look at the menu.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0674-ex3","meaning_en":"first","sentence":"妈妈做饭的时候，首先洗手。","translation":"When Mom cooks, she washes her hands first.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0674-ex1","translation":"When doing this question, first look at the problem."},{"example_id":"new-hsk-3-0674-ex2","translation":"When we arrive at the restaurant, we first look at the menu."},{"example_id":"new-hsk-3-0674-ex3","translation":"When Mom cooks, she washes her hands first."}]}
+{"word":{"id":"new-hsk-3-0675","lang":"zh","lemma":"受","display_form":"受","pos":"unknown","rank":675,"pronunciation":"shòu"},"glosses":{"primary_gloss":"receive","secondary_glosses":["suffer","bear","be favored by"],"notes":"Common verb used in patterns like 受欢迎, 受伤, and 受到照顾."},"examples":[{"id":"new-hsk-3-0675-ex1","meaning_en":"be favored by","sentence":"这家小店很受学生欢迎。","translation":"This small shop is very popular with students.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0675-ex2","meaning_en":"suffer","sentence":"他跑步的时候受了伤。","translation":"He got injured while running.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0675-ex3","meaning_en":"receive","sentence":"生病的时候，她受到了朋友的照顾。","translation":"When she was sick, she received care from a friend.","difficulty":2,"source":"generator-3","is_primary":true}],"example_translations":[{"example_id":"new-hsk-3-0675-ex1","translation":"This small shop is very popular with students."},{"example_id":"new-hsk-3-0675-ex2","translation":"He got injured while running."},{"example_id":"new-hsk-3-0675-ex3","translation":"When she was sick, she received care from a friend."}]}

