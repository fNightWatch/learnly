+{"word":{"id":"new-hsk-3-0734","lang":"zh","lemma":"推动","display_form":"推动","pos":"unknown","rank":734,"pronunciation":"tuī dòng"},"glosses":{"primary_gloss":"push; promote","secondary_glosses":["push forward"],"notes":"Can mean pushing something forward with force, and also helping a plan, activity, or work move ahead."},"examples":[{"id":"new-hsk-3-0734-ex1","meaning_en":"push","sentence":"他们一起推动小车进院子。","translation":"They pushed the small cart into the yard together.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0734-ex2","meaning_en":"push forward","sentence":"这次比赛推动了大家天天练习。","translation":"This competition pushed everyone to practice every day.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0734-ex3","meaning_en":"promote","sentence":"老师的话推动他继续努力。","translation":"The teacher's words encouraged him to keep working hard.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0734-ex1","translation":"They pushed the small cart into the yard together."},{"example_id":"new-hsk-3-0734-ex2","translation":"This competition pushed everyone to practice every day."},{"example_id":"new-hsk-3-0734-ex3","translation":"The teacher's words encouraged him to keep working hard."}]}
