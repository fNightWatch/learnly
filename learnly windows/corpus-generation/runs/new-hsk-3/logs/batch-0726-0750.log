./runs/new-hsk-1/raw/g1-batch-0126-0150.json:1:{"results":[{"word_id":"new-hsk-1-0126","rank":126,"lemma":"关上","meanings":[{"meaning_en":"close","priority":1},{"meaning_en":"shut","priority":2}],"notes":"A common verb for closing or shutting something.","examples":[{"slot":1,"meaning_en":"close","sentence":"请关上门，我要睡觉。","translation":"Please close the door. I want to sleep.","difficulty":1},{"slot":2,"meaning_en":"shut","sentence":"爸爸回家后关上门。","translation":"Dad shut the door after coming home.","difficulty":2}]},{"word_id":"new-hsk-1-0127","rank":127,"lemma":"贵","meanings":[{"meaning_en":"expensive","priority":1},{"meaning_en":"costly","priority":2}],"notes":"For HSK 1, this means expensive, especially for prices.","examples":[{"slot":1,"meaning_en":"expensive","sentence":"这个书包很贵。","translation":"This schoolbag is very expensive.","difficulty":1},{"slot":2,"meaning_en":"costly","sentence":"那个饭店不贵。","translation":"That restaurant isn't costly.","difficulty":2}]},{"word_id":"new-hsk-1-0128","rank":128,"lemma":"国","meanings":[{"meaning_en":"country","priority":1}],"notes":"This means country and often appears in common words like 中国, 国家, and 国外.","examples":[{"slot":1,"meaning_en":"country","sentence":"中国是我的国家。","translation":"China is my country.","difficulty":1},{"slot":2,"meaning_en":"country","sentence":"姐姐想去国外学习。","translation":"My older sister wants to go abroad to study.","difficulty":2}]},{"word_id":"new-hsk-1-0129","rank":129,"lemma":"国家","meanings":[{"meaning_en":"country","priority":1},{"meaning_en":"nation","priority":2}],"notes":"A common noun for a country as a nation.","examples":[{"slot":1,"meaning_en":"country","sentence":"中国是一个国家。","translation":"China is a country.","difficulty":1},{"slot":2,"meaning_en":"nation","sentence":"我爱这个国家。","translation":"I love this nation.","difficulty":2}]},{"word_id":"new-hsk-1-0130","rank":130,"lemma":"国外","meanings":[{"meaning_en":"abroad","priority":1},{"meaning_en":"overseas","priority":2}],"notes":"Use this for being in or going to another country.","examples":[{"slot":1,"meaning_en":"abroad","sentence":"姐姐在国外学习汉语。","translation":"My older sister is studying Chinese abroad.","difficulty":1},{"slot":2,"meaning_en":"overseas","sentence":"爸爸明年去国外工作。","translation":"Dad is going overseas to work next year.","difficulty":2}]},{"word_id":"new-hsk-1-0131","rank":131,"lemma":"过","meanings":[{"meaning_en":"pass","priority":1},{"meaning_en":"go past","priority":2}],"notes":"Keep the basic motion sense of passing or going past.","examples":[{"slot":1,"meaning_en":"pass","sentence":"我过马路去学校。","translation":"I cross the road to go to school.","difficulty":1},{"slot":2,"meaning_en":"go past","sentence":"爸爸开车过这个路口。","translation":"Dad drives past this intersection.","difficulty":2}]},{"word_id":"new-hsk-1-0132","rank":132,"lemma":"还","meanings":[{"meaning_en":"still","priority":1},{"meaning_en":"also","priority":2}],"notes":"Still is the strongest beginner meaning, and also is a common secondary use.","examples":[{"slot":1,"meaning_en":"still","sentence":"姐姐还在房间里看书。","translation":"My older sister is still reading in the room.","difficulty":1},{"slot":2,"meaning_en":"also","sentence":"我爱喝茶，还爱喝牛奶。","translation":"I like drinking tea, and I also like drinking milk.","difficulty":2}]},{"word_id":"new-hsk-1-0133","rank":133,"lemma":"还是","meanings":[{"meaning_en":"still","priority":1},{"meaning_en":"or","priority":2}],"notes":"This can mean still, or it can link two choices in a question.","examples":[{"slot":1,"meaning_en":"still","sentence":"现在还是很冷。","translation":"It is still very cold now.","difficulty":1},{"slot":2,"meaning_en":"or","sentence":"你喝茶还是喝水？","translation":"Do you drink tea or water?","difficulty":2}]},{"word_id":"new-hsk-1-0134","rank":134,"lemma":"还有","meanings":[{"meaning_en":"also have","priority":1},{"meaning_en":"there is also","priority":2},{"meaning_en":"in addition","priority":3}],"notes":"Use this for also having something or for there also being something.","examples":[{"slot":1,"meaning_en":"there is also","sentence":"桌子上还有一本书。","translation":"There is also a book on the table.","difficulty":1},{"slot":2,"meaning_en":"also have","sentence":"我有一个姐姐，还有一个弟弟。","translation":"I have an older sister and also a younger brother.","difficulty":2}]},{"word_id":"new-hsk-1-0135","rank":135,"lemma":"孩子","meanings":[{"meaning_en":"child","priority":1},{"meaning_en":"kid","priority":2}],"notes":"A common learner-friendly word for a child.","examples":[{"slot":1,"meaning_en":"child","sentence":"那个孩子在路上跑。","translation":"That child is running on the road.","difficulty":1},{"slot":2,"meaning_en":"kid","sentence":"这个孩子很喜欢花。","translation":"This kid really likes flowers.","difficulty":2}]},{"word_id":"new-hsk-1-0136","rank":136,"lemma":"汉语","meanings":[{"meaning_en":"Chinese","priority":1},{"meaning_en":"Chinese language","priority":2}],"notes":"Treat this as the Chinese language.","examples":[{"slot":1,"meaning_en":"Chinese","sentence":"我在学校学习汉语。","translation":"I study Chinese at school.","difficulty":1},{"slot":2,"meaning_en":"Chinese language","sentence":"妈妈会说一点儿汉语。","translation":"Mom can speak a little Chinese.","difficulty":2}]},{"word_id":"new-hsk-1-0137","rank":137,"lemma":"汉字","meanings":[{"meaning_en":"Chinese character","priority":1}],"notes":"A noun for a written Chinese character.","examples":[{"slot":1,"meaning_en":"Chinese character","sentence":"这个汉字很难。","translation":"This Chinese character is difficult.","difficulty":1},{"slot":2,"meaning_en":"Chinese character","sentence":"我会写这个汉字。","translation":"I can write this Chinese character.","difficulty":2}]},{"word_id":"new-hsk-1-0138","rank":138,"lemma":"好","meanings":[{"meaning_en":"good","priority":1}],"notes":"This entry is the adjective meaning good.","examples":[{"slot":1,"meaning_en":"good","sentence":"今天天气很好。","translation":"The weather is good today.","difficulty":1},{"slot":2,"meaning_en":"good","sentence":"老师很好，我们都喜欢。","translation":"The teacher is very good, and we all like them.","difficulty":2}]},{"word_id":"new-hsk-1-0139","rank":139,"lemma":"好吃","meanings":[{"meaning_en":"delicious","priority":1},{"meaning_en":"tasty","priority":2}],"notes":"Use this for food that tastes good.","examples":[{"slot":1,"meaning_en":"delicious","sentence":"这个包子很好吃。","translation":"This bun is delicious.","difficulty":1},{"slot":2,"meaning_en":"tasty","sentence":"妈妈做的菜真好吃。","translation":"The food Mom made is really tasty.","difficulty":2}]},{"word_id":"new-hsk-1-0140","rank":140,"lemma":"好看","meanings":[{"meaning_en":"good-looking","priority":1},{"meaning_en":"nice","priority":2},{"meaning_en":"good to watch","priority":3}],"notes":"Use it for people, things, or movies that look good.","examples":[{"slot":1,"meaning_en":"good-looking","sentence":"姐姐今天很好看。","translation":"My older sister looks good today.","difficulty":1},{"slot":2,"meaning_en":"good to watch","sentence":"这个电影很好看。","translation":"This movie is very good to watch.","difficulty":2}]},{"word_id":"new-hsk-1-0141","rank":141,"lemma":"好听","meanings":[{"meaning_en":"pleasant to hear","priority":1},{"meaning_en":"nice-sounding","priority":2}],"notes":"Use this for songs, sounds, or names that sound nice.","examples":[{"slot":1,"meaning_en":"pleasant to hear","sentence":"姐姐唱的歌很好听。","translation":"The song my older sister sings is pleasant to hear.","difficulty":1},{"slot":2,"meaning_en":"nice-sounding","sentence":"这个名字很好听。","translation":"This name sounds nice.","difficulty":2}]},{"word_id":"new-hsk-1-0142","rank":142,"lemma":"好玩儿","meanings":[{"meaning_en":"fun","priority":1},{"meaning_en":"interesting","priority":2}],"notes":"Fun is the clearest beginner meaning.","examples":[{"slot":1,"meaning_en":"fun","sentence":"打球很好玩儿。","translation":"Playing ball is fun.","difficulty":1},{"slot":2,"meaning_en":"interesting","sentence":"北京真的很好玩儿。","translation":"Beijing is really interesting and fun.","difficulty":2}]},{"word_id":"new-hsk-1-0143","rank":143,"lemma":"号","meanings":[{"meaning_en":"number","priority":1},{"meaning_en":"day of the month","priority":2}],"notes":"Use it for numbers like room numbers and for calendar dates.","examples":[{"slot":1,"meaning_en":"day of the month","sentence":"今天是二号。","translation":"Today is the second.","difficulty":1},{"slot":2,"meaning_en":"number","sentence":"我在八号房间里。","translation":"I'm in room number eight.","difficulty":2}]},{"word_id":"new-hsk-1-0144","rank":144,"lemma":"喝","meanings":[{"meaning_en":"drink","priority":1}],"notes":"A common verb for drinking liquids.","examples":[{"slot":1,"meaning_en":"drink","sentence":"我早上喝一杯牛奶。","translation":"I drink a glass of milk in the morning.","difficulty":1},{"slot":2,"meaning_en":"drink","sentence":"爸爸晚上喝一杯茶。","translation":"Dad drinks a cup of tea in the evening.","difficulty":2}]},{"word_id":"new-hsk-1-0145","rank":145,"lemma":"和","meanings":[{"meaning_en":"and","priority":1}],"notes":"Use this as the conjunction and.","examples":[{"slot":1,"meaning_en":"and","sentence":"妈妈和爸爸都在家。","translation":"Mom and Dad are both at home.","difficulty":1},{"slot":2,"meaning_en":"and","sentence":"我想买面包和牛奶。","translation":"I want to buy bread and milk.","difficulty":2}]},{"word_id":"new-hsk-1-0146","rank":146,"lemma":"很","meanings":[{"meaning_en":"very","priority":1}],"notes":"A common adverb meaning very.","examples":[{"slot":1,"meaning_en":"very","sentence":"我今天很高兴。","translation":"I'm very happy today.","difficulty":1},{"slot":2,"meaning_en":"very","sentence":"我的房间很干净。","translation":"My room is very clean.","difficulty":2}]},{"word_id":"new-hsk-1-0147","rank":147,"lemma":"后","meanings":[{"meaning_en":"behind","priority":1},{"meaning_en":"back","priority":2},{"meaning_en":"after","priority":3}],"notes":"It can mean behind or back in place phrases, and after in time phrases.","examples":[{"slot":1,"meaning_en":"after","sentence":"下班后爸爸回家吃饭。","translation":"Dad goes home to eat after work.","difficulty":1},{"slot":2,"meaning_en":"after","sentence":"上课后我们去图书馆。","translation":"We go to the library after class.","difficulty":2}]},{"word_id":"new-hsk-1-0148","rank":148,"lemma":"后边","meanings":[{"meaning_en":"behind","priority":1},{"meaning_en":"in back of","priority":2}],"notes":"A place word meaning behind something or someone.","examples":[{"slot":1,"meaning_en":"behind","sentence":"学校后边有一个商店。","translation":"There is a shop behind the school.","difficulty":1},{"slot":2,"meaning_en":"in back of","sentence":"我坐在爸爸后边。","translation":"I sit in back of Dad.","difficulty":2}]},{"word_id":"new-hsk-1-0149","rank":149,"lemma":"后天","meanings":[{"meaning_en":"day after tomorrow","priority":1}],"notes":"A time phrase for two days from today.","examples":[{"slot":1,"meaning_en":"day after tomorrow","sentence":"后天我们有考试。","translation":"We have an exam the day after tomorrow.","difficulty":1},{"slot":2,"meaning_en":"day after tomorrow","sentence":"妈妈后天回北京。","translation":"Mom goes back to Beijing the day after tomorrow.","difficulty":2}]},{"word_id":"new-hsk-1-0150","rank":150,"lemma":"花","meanings":[{"meaning_en":"flower","priority":1}],"notes":"This entry is the noun flower.","examples":[{"slot":1,"meaning_en":"flower","sentence":"桌子上有很多花。","translation":"There are many flowers on the table.","difficulty":1},{"slot":2,"meaning_en":"flower","sentence":"妈妈今天买了花。","translation":"Mom bought flowers today.","difficulty":2}]}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch1.jsonl:1:{"word": {"id": "new-hsk-2-0178", "lang": "zh", "lemma": "感觉", "display_form": "感觉", "pos": "unknown", "rank": 178, "pronunciation": "gǎnjué"}, "glosses": {"primary_gloss": "feel; feeling", "secondary_glosses": ["sense", "impression"], "notes": "Can be a verb meaning to feel or a noun meaning a feeling or impression."}, "examples": [{"id": "new-hsk-2-0178-ex1", "sentence": "我感觉今天不太冷。", "meaning_en": "feel", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0178-ex2", "sentence": "妈妈感觉有点累。", "meaning_en": "feel", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0178-ex3", "sentence": "我对这个地方感觉很好。", "meaning_en": "feeling", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0178-ex1", "translation": "I feel it is not very cold today."}, {"example_id": "new-hsk-2-0178-ex2", "translation": "Mom feels a little tired."}, {"example_id": "new-hsk-2-0178-ex3", "translation": "I have a good feeling about this place."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch1.jsonl:2:{"word": {"id": "new-hsk-2-0201", "lang": "zh", "lemma": "关机", "display_form": "关机", "pos": "unknown", "rank": 201, "pronunciation": "guān jī"}, "glosses": {"primary_gloss": "turn off; shut down", "secondary_glosses": ["power off a device"], "notes": "Used for turning off a phone, computer, or other device."}, "examples": [{"id": "new-hsk-2-0201-ex1", "sentence": "上课前，请先关机。", "meaning_en": "turn off a device", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0201-ex2", "sentence": "开会的时候，大家都关机了。", "meaning_en": "turn off devices", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0201-ex3", "sentence": "我的计算机关机了，现在不能上网。", "meaning_en": "device is off", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0201-ex1", "translation": "Please turn it off before class."}, {"example_id": "new-hsk-2-0201-ex2", "translation": "During the meeting, everyone turned off their devices."}, {"example_id": "new-hsk-2-0201-ex3", "translation": "My computer is shut down, so I cannot go online now."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch1.jsonl:3:{"word": {"id": "new-hsk-2-0202", "lang": "zh", "lemma": "关心", "display_form": "关心", "pos": "unknown", "rank": 202, "pronunciation": "guānxīn"}, "glosses": {"primary_gloss": "care about; show concern for", "secondary_glosses": ["care for"], "notes": "Usually used for caring about a person, health, study, or situation."}, "examples": [{"id": "new-hsk-2-0202-ex1", "sentence": "老师很关心我们的学习。", "meaning_en": "care about", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0202-ex2", "sentence": "妈妈常关心我的身体。", "meaning_en": "care about health", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0202-ex3", "sentence": "朋友这样关心我，我很高兴。", "meaning_en": "show concern", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0202-ex1", "translation": "The teacher cares a lot about our studies."}, {"example_id": "new-hsk-2-0202-ex2", "translation": "Mom often cares about my health."}, {"example_id": "new-hsk-2-0202-ex3", "translation": "I am happy that my friend cares about me like this."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch1.jsonl:4:{"word": {"id": "new-hsk-2-0203", "lang": "zh", "lemma": "观点", "display_form": "观点", "pos": "unknown", "rank": 203, "pronunciation": "guāndiǎn"}, "glosses": {"primary_gloss": "viewpoint; opinion", "secondary_glosses": ["point of view"], "notes": "A person's opinion or way of seeing an issue."}, "examples": [{"id": "new-hsk-2-0203-ex1", "sentence": "我想听听你的观点。", "meaning_en": "opinion", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0203-ex2", "sentence": "他的观点和我不一样。", "meaning_en": "viewpoint", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0203-ex3", "sentence": "这个问题上，我们的观点一样。", "meaning_en": "point of view", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0203-ex1", "translation": "I want to hear your opinion."}, {"example_id": "new-hsk-2-0203-ex2", "translation": "His opinion is different from mine."}, {"example_id": "new-hsk-2-0203-ex3", "translation": "On this question, our views are the same."}]}
