{"word":{"id":"new-hsk-3-0737","lang":"zh","lemma":"推开","display_form":"推开","pos":"unknown","rank":737,"pronunciation":"tuī kāi"},"glosses":{"primary_gloss":"push open","secondary_glosses":["push aside"],"notes":"Usually means pushing a door, window, or object so it opens or moves away."},"examples":[{"id":"new-hsk-3-0737-ex1","meaning_en":"push open","sentence":"他轻轻推开门，走了进去。","translation":"He gently pushed the door open and walked in.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0737-ex2","meaning_en":"push open","sentence":"妈妈推开门，让风进来。","translation":"Mom pushed the door open and let the wind come in.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0737-ex3","meaning_en":"push aside","sentence":"她把椅子推开，坐在妈妈旁边。","translation":"She pushed the chair aside and sat next to Mom.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0737-ex1","translation":"He gently pushed the door open and walked in."},{"example_id":"new-hsk-3-0737-ex2","translation":"Mom pushed the door open and let the wind come in."},{"example_id":"new-hsk-3-0737-ex3","translation":"She pushed the chair aside and sat next to Mom."}]}
