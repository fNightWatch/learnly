./runs/new-hsk-2/hsk2-strict-repairs-batch2.jsonl:1:{"word": {"id": "new-hsk-2-0243", "lang": "zh", "lemma": "回", "display_form": "回", "pos": "measure word", "rank": 243, "pronunciation": "huí"}, "glosses": {"primary_gloss": "time; occasion; measure word for times", "secondary_glosses": ["one time", "one round"], "notes": "A measure word used for how many times something happens."}, "examples": [{"id": "new-hsk-2-0243-ex1", "sentence": "这个电影我看了两回。", "meaning_en": "number of times", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0243-ex2", "sentence": "老师这句话讲了三回。", "meaning_en": "repeat something", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0243-ex3", "sentence": "你再说一回，我没听到。", "meaning_en": "one more time", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0243-ex1", "translation": "I have watched this movie twice."}, {"example_id": "new-hsk-2-0243-ex2", "translation": "The teacher said this sentence three times."}, {"example_id": "new-hsk-2-0243-ex3", "translation": "Please say it one more time. I did not hear it."}]}
