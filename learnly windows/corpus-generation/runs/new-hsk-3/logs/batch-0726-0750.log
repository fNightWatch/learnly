ence":"老师今天考我们汉字。","translation":"The teacher is testing us on Chinese characters today.","difficulty":2}]},{"word_id":"new-hsk-1-0197","rank":197,"lemma":"考试","examples":[{"slot":3,"meaning_en":"exam","sentence":"明天我们有汉语考试。","translation":"We have a Chinese exam tomorrow.","difficulty":1}]},{"word_id":"new-hsk-1-0198","rank":198,"lemma":"渴","examples":[{"slot":3,"meaning_en":"thirsty","sentence":"下课后我很渴，想喝水。","translation":"After class I'm very thirsty and want some water.","difficulty":1}]},{"word_id":"new-hsk-1-0199","rank":199,"lemma":"课","examples":[{"slot":3,"meaning_en":"class","sentence":"我们下午有汉语课。","translation":"We have Chinese class this afternoon.","difficulty":1}]},{"word_id":"new-hsk-1-0200","rank":200,"lemma":"课本","examples":[{"slot":3,"meaning_en":"textbook","sentence":"我的课本在书包里。","translation":"My textbook is in my schoolbag.","difficulty":1}]}]}
./runs/new-hsk-1/raw/g1-batch-0476-0500.json:1:{"results": [{"word_id": "new-hsk-1-0476", "rank": 476, "lemma": "中", "meanings": [{"meaning_en": "middle", "priority": 1}, {"meaning_en": "among", "priority": 2}, {"meaning_en": "in", "priority": 3}], "notes": "Use middle as the clearest primary gloss, while among and in are also common in beginner patterns like 三个人中 and 名字中.", "examples": [{"slot": 1, "meaning_en": "middle", "sentence": "中国的中是中间的中。", "translation": "The 中 in 中国 is the same 中 as in 中间.", "difficulty": 2}, {"slot": 2, "meaning_en": "among", "sentence": "我在三个人中最高。", "translation": "I am the tallest among the three people.", "difficulty": 2}]}, {"word_id": "new-hsk-1-0477", "rank": 477, "lemma": "中国", "meanings": [{"meaning_en": "China", "priority": 1}], "notes": "Use the country name China.", "examples": [{"slot": 1, "meaning_en": "China", "sentence": "我想去中国。", "translation": "I want to go to China.", "difficulty": 1}, {"slot": 2, "meaning_en": "China", "sentence": "中国很大。", "translation": "China is very big.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0478", "rank": 478, "lemma": "中间", "meanings": [{"meaning_en": "middle", "priority": 1}, {"meaning_en": "in the middle", "priority": 2}], "notes": "Use middle and in the middle for location.", "examples": [{"slot": 1, "meaning_en": "middle", "sentence": "书在桌子中间。", "translation": "The book is in the middle of the table.", "difficulty": 1}, {"slot": 2, "meaning_en": "in the middle", "sentence": "我坐在爸爸妈妈中间。", "translation": "I sit between Mom and Dad.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0479", "rank": 479, "lemma": "中文", "meanings": [{"meaning_en": "Chinese", "priority": 1}], "notes": "Use Chinese as the language name.", "examples": [{"slot": 1, "meaning_en": "Chinese", "sentence": "我会说中文。", "translation": "I can speak Chinese.", "difficulty": 1}, {"slot": 2, "meaning_en": "Chinese", "sentence": "我在学中文。", "translation": "I am learning Chinese.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0480", "rank": 480, "lemma": "中午", "meanings": [{"meaning_en": "noon", "priority": 1}], "notes": "Use noon as the time word.", "examples": [{"slot": 1, "meaning_en": "noon", "sentence": "我们中午吃米饭。", "translation": "We eat rice at noon.", "difficulty": 1}, {"slot": 2, "meaning_en": "noon", "sentence": "妈妈中午回家。", "translation": "Mom goes home at noon.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0481", "rank": 481, "lemma": "中学", "meanings": [{"meaning_en": "middle school", "priority": 1}], "notes": "Use the noun middle school.", "examples": [{"slot": 1, "meaning_en": "middle school", "sentence": "我姐姐在中学上学。", "translation": "My older sister studies at a middle school.", "difficulty": 1}, {"slot": 2, "meaning_en": "middle school", "sentence": "这个中学很大。", "translation": "This middle school is very big.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0482", "rank": 482, "lemma": "中学生", "meanings": [{"meaning_en": "middle school student", "priority": 1}], "notes": "Use the noun middle school student.", "examples": [{"slot": 1, "meaning_en": "middle school student", "sentence": "我姐姐是中学生。", "translation": "My older sister is a middle school student.", "difficulty": 1}, {"slot": 2, "meaning_en": "middle school student", "sentence": "那个中学生会说中文。", "translation": "That middle school student can speak Chinese.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0483", "rank": 483, "lemma": "重", "meanings": [{"meaning_en": "heavy", "priority": 1}], "notes": "Use heavy as the adjective.", "examples": [{"slot": 1, "meaning_en": "heavy", "sentence": "这个书包很重。", "translation": "This schoolbag is heavy.", "difficulty": 1}, {"slot": 2, "meaning_en": "heavy", "sentence": "这本书很重。", "translation": "This book is heavy.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0484", "rank": 484, "lemma": "重要", "meanings": [{"meaning_en": "important", "priority": 1}], "notes": "Use important as the adjective.", "examples": [{"slot": 1, "meaning_en": "important", "sentence": "这个很重要。", "translation": "This is very important.", "difficulty": 1}, {"slot": 2, "meaning_en": "important", "sentence": "时间很重要。", "translation": "Time is important.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0485", "rank": 485, "lemma": "住", "meanings": [{"meaning_en": "live", "priority": 1}], "notes": "Use live as the verb.", "examples": [{"slot": 1, "meaning_en": "live", "sentence": "我住在北京。", "translation": "I live in Beijing.", "difficulty": 1}, {"slot": 2, "meaning_en": "live", "sentence": "爸爸妈妈住在中国。", "translation": "Mom and Dad live in China.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0486", "rank": 486, "lemma": "准备", "meanings": [{"meaning_en": "prepare", "priority": 1}, {"meaning_en": "get ready", "priority": 2}], "notes": "Use prepare as the main gloss and get ready as a natural secondary gloss.", "examples": [{"slot": 1, "meaning_en": "prepare", "sentence": "我在准备晚饭。", "translation": "I am preparing dinner.", "difficulty": 1}, {"slot": 2, "meaning_en": "get ready", "sentence": "妈妈准备去医院。", "translation": "Mom is getting ready to go to the hospital.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0487", "rank": 487, "lemma": "桌子", "meanings": [{"meaning_en": "table", "priority": 1}], "notes": "Use the noun table.", "examples": [{"slot": 1, "meaning_en": "table", "sentence": "书在桌子上。", "translation": "The book is on the table.", "difficulty": 1}, {"slot": 2, "meaning_en": "table", "sentence": "桌子下边有一个球。", "translation": "There is a ball under the table.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0488", "rank": 488, "lemma": "字", "meanings": [{"meaning_en": "character", "priority": 1}, {"meaning_en": "word", "priority": 2}], "notes": "Use character as the main gloss; word is a weaker but still useful secondary gloss.", "examples": [{"slot": 1, "meaning_en": "character", "sentence": "这个字怎么写？", "translation": "How do you write this character?", "difficulty": 1}, {"slot": 2, "meaning_en": "character", "sentence": "我会写很多汉字。", "translation": "I can write many Chinese characters.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0489", "rank": 489, "lemma": "子", "meanings": [{"meaning_en": "noun suffix", "priority": 1}], "notes": "Use 子 as the common noun suffix seen in words like 杯子, 桌子, and 包子.", "examples": [{"slot": 1, "meaning_en": "noun suffix", "sentence": "这个杯子很大。", "translation": "This cup is big.", "difficulty": 1}, {"slot": 2, "meaning_en": "noun suffix", "sentence": "桌子上有一本书。", "translation": "There is a book on the table.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0490", "rank": 490, "lemma": "走", "meanings": [{"meaning_en": "walk", "priority": 1}, {"meaning_en": "go", "priority": 2}], "notes": "Use walk as the primary gloss and go where it sounds more natural.", "examples": [{"slot": 1, "meaning_en": "go", "sentence": "我们走吧。", "translation": "Let's go.", "difficulty": 1}, {"slot": 2, "meaning_en": "go", "sentence": "你先走，我一会儿来。", "translation": "You go first; I will come in a moment.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0491", "rank": 491, "lemma": "走路", "meanings": [{"meaning_en": "walk", "priority": 1}], "notes": "Use walk as the verb.", "examples": [{"slot": 1, "meaning_en": "walk", "sentence": "我走路去学校。", "translation": "I walk to school.", "difficulty": 1}, {"slot": 2, "meaning_en": "walk", "sentence": "爸爸喜欢走路。", "translation": "Dad likes walking.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0492", "rank": 492, "lemma": "最", "meanings": [{"meaning_en": "most", "priority": 1}], "notes": "Use most as the adverb.", "examples": [{"slot": 1, "meaning_en": "most", "sentence": "我最喜欢中文。", "translation": "I like Chinese the most.", "difficulty": 1}, {"slot": 2, "meaning_en": "most", "sentence": "今天我最早到学校。", "translation": "I got to school the earliest today.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0493", "rank": 493, "lemma": "最好", "meanings": [{"meaning_en": "best", "priority": 1}], "notes": "Use best as the adjective or adverb.", "examples": [{"slot": 1, "meaning_en": "best", "sentence": "这个最好。", "translation": "This one is the best.", "difficulty": 1}, {"slot": 2, "meaning_en": "best", "sentence": "我觉得这个时间最好。", "translation": "I think this time is the best.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0494", "rank": 494, "lemma": "最后", "meanings": [{"meaning_en": "last", "priority": 1}, {"meaning_en": "final", "priority": 2}], "notes": "Use last as the primary gloss and final as a useful secondary gloss.", "examples": [{"slot": 1, "meaning_en": "last", "sentence": "我最后回家。", "translation": "I am the last to go home.", "difficulty": 1}, {"slot": 2, "meaning_en": "final", "sentence": "最后一个字是大。", "translation": "The last character is 大.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0495", "rank": 495, "lemma": "昨天", "meanings": [{"meaning_en": "yesterday", "priority": 1}], "notes": "Use yesterday as the time word.", "examples": [{"slot": 1, "meaning_en": "yesterday", "sentence": "我昨天在家看书。", "translation": "I read at home yesterday.", "difficulty": 1}, {"slot": 2, "meaning_en": "yesterday", "sentence": "昨天妈妈去了医院。", "translation": "Mom went to the hospital yesterday.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0496", "rank": 496, "lemma": "左", "meanings": [{"meaning_en": "left", "priority": 1}], "notes": "Use the direction left.", "examples": [{"slot": 1, "meaning_en": "left", "sentence": "左是西，右是东。", "translation": "Left is west, and right is east.", "difficulty": 1}, {"slot": 2, "meaning_en": "left", "sentence": "我在左，你在右。", "translation": "I am on the left, and you are on the right.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0497", "rank": 497, "lemma": "左边", "meanings": [{"meaning_en": "left side", "priority": 1}, {"meaning_en": "left", "priority": 2}], "notes": "Left side is the clearest learner-facing gloss.", "examples": [{"slot": 1, "meaning_en": "left side", "sentence": "学校左边有一个书店。", "translation": "There is a bookstore on the left side of the school.", "difficulty": 1}, {"slot": 2, "meaning_en": "left", "sentence": "我的包在你左边。", "translation": "My bag is to your left.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0498", "rank": 498, "lemma": "坐", "meanings": [{"meaning_en": "sit", "priority": 1}], "notes": "Use sit as the verb.", "examples": [{"slot": 1, "meaning_en": "sit", "sentence": "请坐。", "translation": "Please sit.", "difficulty": 1}, {"slot": 2, "meaning_en": "sit", "sentence": "我坐在你后边。", "translation": "I sit behind you.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0499", "rank": 499, "lemma": "坐下", "meanings": [{"meaning_en": "sit down", "priority": 1}], "notes": "Use the verb sit down.", "examples": [{"slot": 1, "meaning_en": "sit down", "sentence": "请坐下。", "translation": "Please sit down.", "difficulty": 1}, {"slot": 2, "meaning_en": "sit down", "sentence": "大家坐下吧。", "translation": "Everyone, sit down.", "difficulty": 1}]}, {"word_id": "new-hsk-1-0500", "rank": 500, "lemma": "做", "meanings": [{"meaning_en": "do", "priority": 1}, {"meaning_en": "make", "priority": 2}], "notes": "Use do as the main gloss and make when it is the clearer English choice in context.", "examples": [{"slot": 1, "meaning_en": "make", "sentence": "妈妈在家做饭。", "translation": "Mom is cooking at home.", "difficulty": 1}, {"slot": 2, "meaning_en": "make", "sentence": "这个包子是妈妈做的。", "translation": "This bun was made by Mom.", "difficulty": 1}]}]}
