./runs/new-hsk-1/raw/g1-batch-0301-0325.json:1:{"results":[{"word_id":"new-hsk-1-0301","rank":301,"lemma":"球","meanings":[{"meaning_en":"ball","priority":1}],"notes":"A common noun for a ball.","examples":[{"slot":1,"meaning_en":"ball","sentence":"我买了一个新球。","translation":"I bought a new ball.","difficulty":1},{"slot":2,"meaning_en":"ball","sentence":"弟弟的球在桌子下边。","translation":"My younger brother's ball is under the table.","difficulty":2}]},{"word_id":"new-hsk-1-0302","rank":302,"lemma":"去","meanings":[{"meaning_en":"go","priority":1}],"notes":"The basic verb for going somewhere.","examples":[{"slot":1,"meaning_en":"go","sentence":"我下午去商店买菜。","translation":"I'm going to the shop this afternoon to buy vegetables.","difficulty":1},{"slot":2,"meaning_en":"go","sentence":"姐姐明天去北京上学。","translation":"My older sister is going to Beijing tomorrow to study.","difficulty":2}]},{"word_id":"new-hsk-1-0303","rank":303,"lemma":"去年","meanings":[{"meaning_en":"last year","priority":1}],"notes":"A time phrase for the previous year.","examples":[{"slot":1,"meaning_en":"last year","sentence":"去年我在北京工作。","translation":"I worked in Beijing last year.","difficulty":1},{"slot":2,"meaning_en":"last year","sentence":"姐姐去年学了汉语。","translation":"My older sister studied Chinese last year.","difficulty":2}]},{"word_id":"new-hsk-1-0304","rank":304,"lemma":"热","meanings":[{"meaning_en":"hot","priority":1}],"notes":"A common adjective for heat or hot weather.","examples":[{"slot":1,"meaning_en":"hot","sentence":"今天太热了，喝水吧。","translation":"It's too hot today, so drink some water.","difficulty":1},{"slot":2,"meaning_en":"hot","sentence":"这个菜还很热。","translation":"This dish is still hot.","difficulty":2}]},{"word_id":"new-hsk-1-0305","rank":305,"lemma":"人","meanings":[{"meaning_en":"person","priority":1},{"meaning_en":"people","priority":2}],"notes":"A basic noun for a person or for people in general.","examples":[{"slot":1,"meaning_en":"person","sentence":"那个人是我老师。","translation":"That person is my teacher.","difficulty":1},{"slot":2,"meaning_en":"people","sentence":"商店里人很多。","translation":"There are a lot of people in the shop.","difficulty":2}]},{"word_id":"new-hsk-1-0306","rank":306,"lemma":"认识","meanings":[{"meaning_en":"know","priority":1},{"meaning_en":"recognize","priority":2}],"notes":"Use this for knowing a person or recognizing something.","examples":[{"slot":1,"meaning_en":"know","sentence":"我和姐姐都认识他。","translation":"My older sister and I both know him.","difficulty":1},{"slot":2,"meaning_en":"recognize","sentence":"我不认识这个汉字。","translation":"I don't recognize this Chinese character.","difficulty":2}]},{"word_id":"new-hsk-1-0307","rank":307,"lemma":"认真","meanings":[{"meaning_en":"serious","priority":1},{"meaning_en":"careful","priority":2}],"notes":"A common adjective for being serious and careful.","examples":[{"slot":1,"meaning_en":"serious","sentence":"老师很认真地上课。","translation":"The teacher teaches very seriously.","difficulty":1},{"slot":2,"meaning_en":"careful","sentence":"我妹妹学习很认真。","translation":"My younger sister studies very carefully.","difficulty":2}]},{"word_id":"new-hsk-1-0308","rank":308,"lemma":"日","meanings":[{"meaning_en":"day","priority":1}],"notes":"A basic written form meaning day, often used in dates.","examples":[{"slot":1,"meaning_en":"day","sentence":"今天是三月八日。","translation":"Today is March 8th.","difficulty":1},{"slot":2,"meaning_en":"day","sentence":"一月一日是新年。","translation":"January 1st is New Year's Day.","difficulty":2}]},{"word_id":"new-hsk-1-0309","rank":309,"lemma":"日期","meanings":[{"meaning_en":"date","priority":1}],"notes":"A noun for a calendar date.","examples":[{"slot":1,"meaning_en":"date","sentence":"请你写今天的日期。","translation":"Please write today's date.","difficulty":1},{"slot":2,"meaning_en":"date","sentence":"这个日期我记住了。","translation":"I remembered this date.","difficulty":2}]},{"word_id":"new-hsk-1-0310","rank":310,"lemma":"肉","meanings":[{"meaning_en":"meat","priority":1}],"notes":"The common noun for meat.","examples":[{"slot":1,"meaning_en":"meat","sentence":"弟弟不爱吃肉。","translation":"My younger brother doesn't like eating meat.","difficulty":1},{"slot":2,"meaning_en":"meat","sentence":"今天妈妈买了肉。","translation":"Mom bought meat today.","difficulty":2}]},{"word_id":"new-hsk-1-0311","rank":311,"lemma":"三","meanings":[{"meaning_en":"three","priority":1}],"notes":"The number three.","examples":[{"slot":1,"meaning_en":"three","sentence":"我买了三个包子。","translation":"I bought three buns.","difficulty":1},{"slot":2,"meaning_en":"three","sentence":"现在下午三点了。","translation":"It's three in the afternoon now.","difficulty":2}]},{"word_id":"new-hsk-1-0312","rank":312,"lemma":"山","meanings":[{"meaning_en":"mountain","priority":1}],"notes":"A common noun for a mountain.","examples":[{"slot":1,"meaning_en":"mountain","sentence":"那边有山，也有水。","translation":"There are mountains there, and there is water too.","difficulty":1},{"slot":2,"meaning_en":"mountain","sentence":"爸爸昨天去山上了。","translation":"Dad went up the mountain yesterday.","difficulty":2}]},{"word_id":"new-hsk-1-0313","rank":313,"lemma":"商场","meanings":[{"meaning_en":"shopping mall","priority":1},{"meaning_en":"mall","priority":2}],"notes":"A common noun for a shopping mall.","examples":[{"slot":1,"meaning_en":"shopping mall","sentence":"我们下午去商场买衣服。","translation":"We're going to the shopping mall this afternoon to buy clothes.","difficulty":1},{"slot":2,"meaning_en":"mall","sentence":"商场里边有很多人。","translation":"There are many people inside the mall.","difficulty":2}]},{"word_id":"new-hsk-1-0314","rank":314,"lemma":"商店","meanings":[{"meaning_en":"shop","priority":1},{"meaning_en":"store","priority":2}],"notes":"A common noun for a shop or store.","examples":[{"slot":1,"meaning_en":"shop","sentence":"妈妈在商店买水果。","translation":"Mom is buying fruit at the shop.","difficulty":1},{"slot":2,"meaning_en":"store","sentence":"商店里有很多东西。","translation":"There are many things in the store.","difficulty":2}]},{"word_id":"new-hsk-1-0315","rank":315,"lemma":"上","meanings":[{"meaning_en":"on","priority":1},{"meaning_en":"above","priority":2}],"notes":"Most often this is used in location phrases meaning on.","examples":[{"slot":1,"meaning_en":"on","sentence":"我的书包在桌子上。","translation":"My schoolbag is on the table.","difficulty":1},{"slot":2,"meaning_en":"on","sentence":"这个字在课本上。","translation":"This character is in the textbook.","difficulty":2}]},{"word_id":"new-hsk-1-0316","rank":316,"lemma":"上班","meanings":[{"meaning_en":"go to work","priority":1}],"notes":"The everyday verb for going to work.","examples":[{"slot":1,"meaning_en":"go to work","sentence":"爸爸早上八点上班。","translation":"Dad goes to work at eight in the morning.","difficulty":1},{"slot":2,"meaning_en":"go to work","sentence":"妈妈下雨也去上班。","translation":"Mom still goes to work when it rains.","difficulty":2}]},{"word_id":"new-hsk-1-0317","rank":317,"lemma":"上边","meanings":[{"meaning_en":"above","priority":1},{"meaning_en":"on top","priority":2}],"notes":"A place word meaning above or on top.","examples":[{"slot":1,"meaning_en":"above","sentence":"我的书在电脑上边。","translation":"My book is above the computer.","difficulty":1},{"slot":2,"meaning_en":"on top","sentence":"那个包在桌子上边。","translation":"That bag is on top of the table.","difficulty":2}]},{"word_id":"new-hsk-1-0318","rank":318,"lemma":"上车","meanings":[{"meaning_en":"get on","priority":1},{"meaning_en":"board","priority":2}],"notes":"Use this for getting onto a bus, car, or train.","examples":[{"slot":1,"meaning_en":"get on","sentence":"我们到了车站就上车。","translation":"We got on the vehicle as soon as we arrived at the station.","difficulty":1},{"slot":2,"meaning_en":"board","sentence":"妈妈叫我快上车。","translation":"Mom told me to get on quickly.","difficulty":2}]},{"word_id":"new-hsk-1-0319","rank":319,"lemma":"上次","meanings":[{"meaning_en":"last time","priority":1}],"notes":"A time phrase meaning the previous time.","examples":[{"slot":1,"meaning_en":"last time","sentence":"上次我在这里看见你。","translation":"I saw you here last time.","difficulty":1},{"slot":2,"meaning_en":"last time","sentence":"上次考试我很认真。","translation":"I was very serious on the last exam.","difficulty":2}]},{"word_id":"new-hsk-1-0320","rank":320,"lemma":"上课","meanings":[{"meaning_en":"attend class","priority":1},{"meaning_en":"have class","priority":2}],"notes":"A common school verb for attending or having class.","examples":[{"slot":1,"meaning_en":"attend class","sentence":"我们上午八点上课。","translation":"We have class at eight in the morning.","difficulty":1},{"slot":2,"meaning_en":"have class","sentence":"老师今天在教学楼上课。","translation":"The teacher is teaching in the classroom building today.","difficulty":2}]},{"word_id":"new-hsk-1-0321","rank":321,"lemma":"上网","meanings":[{"meaning_en":"go online","priority":1},{"meaning_en":"use the internet","priority":2}],"notes":"A common phrase for going online or using the internet.","examples":[{"slot":1,"meaning_en":"go online","sentence":"哥哥晚上在家上网。","translation":"My older brother goes online at home in the evening.","difficulty":1},{"slot":2,"meaning_en":"use the internet","sentence":"我今天下午不用上网。","translation":"I don't need to use the internet this afternoon.","difficulty":2}]},{"word_id":"new-hsk-1-0322","rank":322,"lemma":"上午","meanings":[{"meaning_en":"morning","priority":1}],"notes":"A time word for the morning before noon.","examples":[{"slot":1,"meaning_en":"morning","sentence":"我上午有课，下午没有。","translation":"I have class in the morning, but not in the afternoon.","difficulty":1},{"slot":2,"meaning_en":"morning","sentence":"妈妈今天上午去商店。","translation":"Mom is going to the shop this morning.","difficulty":2}]},{"word_id":"new-hsk-1-0323","rank":323,"lemma":"上学","meanings":[{"meaning_en":"go to school","priority":1}],"notes":"The everyday verb for going to school.","examples":[{"slot":1,"meaning_en":"go to school","sentence":"我和朋友一起上学。","translation":"My friend and I go to school together.","difficulty":1},{"slot":2,"meaning_en":"go to school","sentence":"弟弟今天早上去上学。","translation":"My younger brother went to school this morning.","difficulty":2}]},{"word_id":"new-hsk-1-0324","rank":324,"lemma":"少","meanings":[{"meaning_en":"few","priority":1},{"meaning_en":"little","priority":2}],"notes":"Use this for small amounts or small numbers.","examples":[{"slot":1,"meaning_en":"few","sentence":"今天商店里人很少。","translation":"There are very few people in the shop today.","difficulty":1},{"slot":2,"meaning_en":"little","sentence":"牛奶少一点儿就好。","translation":"A little less milk is fine.","difficulty":2}]},{"word_id":"new-hsk-1-0325","rank":325,"lemma":"谁","meanings":[{"meaning_en":"who","priority":1}],"notes":"The basic question word for asking who.","examples":[{"slot":1,"meaning_en":"who","sentence":"谁在门口等你？","translation":"Who is waiting for you at the door?","difficulty":1},{"slot":2,"meaning_en":"who","sentence":"这本书是谁的？","translation":"Whose book is this?","difficulty":2}]}]}
