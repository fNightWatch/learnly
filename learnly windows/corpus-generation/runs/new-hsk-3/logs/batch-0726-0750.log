+{"word":{"id":"new-hsk-3-0746","lang":"zh","lemma":"完整","display_form":"完整","pos":"unknown","rank":746,"pronunciation":"wánzhěng"},"glosses":{"primary_gloss":"complete; intact","secondary_glosses":[],"notes":"Used when something has all its parts or when it stays whole and unbroken."},"examples":[{"id":"new-hsk-3-0746-ex1","meaning_en":"complete","sentence":"这份作业还不完整。","translation":"This homework is still not complete.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0746-ex2","meaning_en":"complete","sentence":"请把名字写完整。","translation":"Please write the name in full.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0746-ex3","meaning_en":"intact","sentence":"杯子掉地上了，还是完整的。","translation":"The cup fell to the ground and was still intact.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0746-ex1","translation":"This homework is still not complete."},{"example_id":"new-hsk-3-0746-ex2","translation":"Please write the name in full."},{"example_id":"new-hsk-3-0746-ex3","translation":"The cup fell to the ground and was still intact."}]}
+{"word":{"id":"new-hsk-3-0747","lang":"zh","lemma":"玩具","display_form":"玩具","pos":"unknown","rank":747,"pronunciation":"wánjù"},"glosses":{"primary_gloss":"toy","secondary_glosses":[],"notes":"An object that children play with, such as a toy car, doll, or ball."},"examples":[{"id":"new-hsk-3-0747-ex1","meaning_en":"toy","sentence":"弟弟买了一个新玩具。","translation":"My younger brother bought a new toy.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0747-ex2","meaning_en":"toy","sentence":"地上都是孩子的玩具。","translation":"The floor is covered with the child's toys.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0747-ex3","meaning_en":"toy","sentence":"这个玩具车在地上跑。","translation":"This toy car runs on the floor.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0747-ex1","translation":"My younger brother bought a new toy."},{"example_id":"new-hsk-3-0747-ex2","translation":"The floor is covered with the child's toys."},{"example_id":"new-hsk-3-0747-ex3","translation":"This toy car runs on the floor."}]}
+{"word":{"id":"new-hsk-3-0748","lang":"zh","lemma":"往往","display_form":"往往","pos":"unknown","rank":748,"pronunciation":"wǎngwǎng"},"glosses":{"primary_gloss":"often; more often than not","secondary_glosses":[],"notes":"Used for a usual tendency or something that often happens in a certain situation."},"examples":[{"id":"new-hsk-3-0748-ex1","meaning_en":"often","sentence":"他太累的时候，往往很早就睡。","translation":"When he is too tired, he often goes to sleep very early.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0748-ex2","meaning_en":"more often than not","sentence":"周末下雨的时候，公园里往往人不多。","translation":"When it rains on weekends, the park is often not very crowded.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0748-ex3","meaning_en":"often","sentence":"孩子一听到音乐，往往就想跳舞。","translation":"As soon as children hear music, they often want to dance.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0748-ex1","translation":"When he is too tired, he often goes to sleep very early."},{"example_id":"new-hsk-3-0748-ex2","translation":"When it rains on weekends, the park is often not very crowded."},{"example_id":"new-hsk-3-0748-ex3","translation":"As soon as children hear music, they often want to dance."}]}
+{"word":{"id":"new-hsk-3-0749","lang":"zh","lemma":"危害","display_form":"危害","pos":"unknown","rank":749,"pronunciation":"wēihài"},"glosses":{"primary_gloss":"harm; endanger","secondary_glosses":[],"notes":"Used when something causes harm to health, safety, or the environment."},"examples":[{"id":"new-hsk-3-0749-ex1","meaning_en":"endanger","sentence":"在路上看手机，会危害安全。","translation":"Looking at your phone on the road can endanger safety.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0749-ex2","meaning_en":"harm","sentence":"这种烟会危害身体。","translation":"This kind of smoke can harm the body.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0749-ex3","meaning_en":"harm","sentence":"晚睡对身体的危害很大。","translation":"Staying up late does a lot of harm to the body.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0749-ex1","translation":"Looking at your phone on the road can endanger safety."},{"example_id":"new-hsk-3-0749-ex2","translation":"This kind of smoke can harm the body."},{"example_id":"new-hsk-3-0749-ex3","translation":"Staying up late does a lot of harm to the body."}]}
+{"word":{"id":"new-hsk-3-0750","lang":"zh","lemma":"危险","display_form":"危险","pos":"unknown","rank":750,"pronunciation":"wēixiǎn"},"glosses":{"primary_gloss":"dangerous; danger","secondary_glosses":[],"notes":"Used when a place, action, or situation is not safe and could cause harm."},"examples":[{"id":"new-hsk-3-0750-ex1","meaning_en":"dangerous","sentence":"这里太危险了，别过去。","translation":"It is too dangerous here, so do not go over there.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0750-ex2","meaning_en":"dangerous","sentence":"这条路晚上很危险。","translation":"This road is very dangerous at night.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0750-ex3","meaning_en":"dangerous","sentence":"雨天开车太快很危险。","translation":"Driving too fast on a rainy day is dangerous.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0750-ex1","translation":"It is too dangerous here, so do not go over there."},{"example_id":"new-hsk-3-0750-ex2","translation":"This road is very dangerous at night."},{"example_id":"new-hsk-3-0750-ex3","translation":"Driving too fast on a rainy day is dangerous."}]}

