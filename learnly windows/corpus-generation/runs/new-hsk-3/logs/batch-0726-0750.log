+{"word":{"id":"new-hsk-3-0727","lang":"zh","lemma":"突然","display_form":"突然","pos":"unknown","rank":727,"pronunciation":"tūrán"},"glosses":{"primary_gloss":"suddenly","secondary_glosses":["all of a sudden"],"notes":"Used when something happens quickly and unexpectedly."},"examples":[{"id":"new-hsk-3-0727-ex1","meaning_en":"suddenly","sentence":"天突然下雨了，我们跑进了店里。","translation":"It suddenly started raining, and we ran into a shop.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0727-ex2","meaning_en":"suddenly","sentence":"我正要睡觉，电话突然响了。","translation":"I was just about to sleep when the phone suddenly rang.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0727-ex3","meaning_en":"all of a sudden","sentence":"他走到门口，突然不说话了。","translation":"When he got to the door, he suddenly stopped talking.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0727-ex1","translation":"It suddenly started raining, and we ran into a shop."},{"example_id":"new-hsk-3-0727-ex2","translation":"I was just about to sleep when the phone suddenly rang."},{"example_id":"new-hsk-3-0727-ex3","translation":"When he got to the door, he suddenly stopped talking."}]}
+{"word":{"id":"new-hsk-3-0728","lang":"zh","lemma":"图","display_form":"图","pos":"unknown","rank":728,"pronunciation":"tú picture;"},"glosses":{"primary_gloss":"picture; diagram","secondary_glosses":["chart"],"notes":"A short everyday word for a picture, diagram, or simple chart that you look at to understand something."},"examples":[{"id":"new-hsk-3-0728-ex1","meaning_en":"diagram","sentence":"老师在黑板上画了一张图。","translation":"The teacher drew a diagram on the blackboard.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0728-ex2","meaning_en":"picture","sentence":"这本书里的图很多。","translation":"This book has a lot of pictures in it.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0728-ex3","meaning_en":"chart","sentence":"我先看图，再看题目。","translation":"I look at the chart first, and then I read the question.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0728-ex1","translation":"The teacher drew a diagram on the blackboard."},{"example_id":"new-hsk-3-0728-ex2","translation":"This book has a lot of pictures in it."},{"example_id":"new-hsk-3-0728-ex3","translation":"I look at the chart first, and then I read the question."}]}
+{"word":{"id":"new-hsk-3-0729","lang":"zh","lemma":"图画","display_form":"图画","pos":"unknown","rank":729,"pronunciation":"tú huà"},"glosses":{"primary_gloss":"drawing; picture","secondary_glosses":["painting"],"notes":"Usually refers to a drawing or picture that someone has made."},"examples":[{"id":"new-hsk-3-0729-ex1","meaning_en":"drawing","sentence":"妹妹下午在家画图画。","translation":"My younger sister draws pictures at home in the afternoon.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0729-ex2","meaning_en":"picture","sentence":"这张图画里有一只猫。","translation":"There is a cat in this picture.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0729-ex3","meaning_en":"drawing","sentence":"妹妹把图画给妈妈看。","translation":"My younger sister showed the drawing to Mom.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0729-ex1","translation":"My younger sister draws pictures at home in the afternoon."},{"example_id":"new-hsk-3-0729-ex2","translation":"There is a cat in this picture."},{"example_id":"new-hsk-3-0729-ex3","translation":"My younger sister showed the drawing to Mom."}]}
+{"word":{"id":"new-hsk-3-0730","lang":"zh","lemma":"土","display_form":"土（名）","pos":"noun","rank":730,"pronunciation":"tǔ"},"glosses":{"primary_gloss":"soil; dirt","secondary_glosses":["earth","ground"],"notes":"The loose earth on the ground, especially the soil in a yard, garden, or field."},"examples":[{"id":"new-hsk-3-0730-ex1","meaning_en":"soil","sentence":"花园里的土很黑。","translation":"The soil in the garden is very dark.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0730-ex2","meaning_en":"dirt","sentence":"孩子跑回来，鞋上都是土。","translation":"The child ran back, and his shoes were covered in dirt.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0730-ex3","meaning_en":"soil","sentence":"妈妈种花以后，手上都是土。","translation":"After planting flowers, Mom's hands were covered in soil.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0730-ex1","translation":"The soil in the garden is very dark."},{"example_id":"new-hsk-3-0730-ex2","translation":"The child ran back, and his shoes were covered in dirt."},{"example_id":"new-hsk-3-0730-ex3","translation":"After planting flowers, Mom's hands were covered in soil."}]}
