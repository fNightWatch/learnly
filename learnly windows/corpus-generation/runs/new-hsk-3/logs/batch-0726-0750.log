ples":[{"slot":3,"meaning_en":"dry","sentence":"这个杯子干了，很干净。","translation":"This cup is dry and very clean.","difficulty":2}]},{"word_id":"new-hsk-1-0112","rank":112,"lemma":"干净","examples":[{"slot":3,"meaning_en":"clean","sentence":"你的房间很干净。","translation":"Your room is very clean.","difficulty":1}]},{"word_id":"new-hsk-1-0113","rank":113,"lemma":"干","examples":[{"slot":3,"meaning_en":"do","sentence":"我想干这个工作。","translation":"I want to do this job.","difficulty":2}]},{"word_id":"new-hsk-1-0114","rank":114,"lemma":"干什么","examples":[{"slot":3,"meaning_en":"what are you doing","sentence":"你们下午在家干什么？","translation":"What are you doing at home this afternoon?","difficulty":1}]},{"word_id":"new-hsk-1-0115","rank":115,"lemma":"高","examples":[{"slot":3,"meaning_en":"tall","sentence":"哥哥比我高一点儿。","translation":"My older brother is a little taller than me.","difficulty":1}]},{"word_id":"new-hsk-1-0116","rank":116,"lemma":"高兴","examples":[{"slot":3,"meaning_en":"happy","sentence":"看到你们，我很高兴。","translation":"I'm very happy to see you.","difficulty":1}]},{"word_id":"new-hsk-1-0117","rank":117,"lemma":"告诉","examples":[{"slot":3,"meaning_en":"tell","sentence":"请你告诉我地点。","translation":"Please tell me the location.","difficulty":1}]},{"word_id":"new-hsk-1-0118","rank":118,"lemma":"哥哥","examples":[{"slot":3,"meaning_en":"older brother","sentence":"哥哥跟朋友去打球了。","translation":"My older brother went to play ball with a friend.","difficulty":1}]},{"word_id":"new-hsk-1-0119","rank":119,"lemma":"歌","examples":[{"slot":3,"meaning_en":"song","sentence":"这个歌很好听，我喜欢。","translation":"This song sounds great, and I like it.","difficulty":1}]},{"word_id":"new-hsk-1-0120","rank":120,"lemma":"个","examples":[{"slot":3,"meaning_en":"general classifier","sentence":"我有一个哥哥，一个姐姐。","translation":"I have one older brother and one older sister.","difficulty":1}]},{"word_id":"new-hsk-1-0121","rank":121,"lemma":"给","examples":[{"slot":3,"meaning_en":"give","sentence":"请给我一杯水。","translation":"Please give me a cup of water.","difficulty":1}]},{"word_id":"new-hsk-1-0122","rank":122,"lemma":"跟","examples":[{"slot":3,"meaning_en":"with","sentence":"我跟哥哥一起回家。","translation":"I'm going home with my older brother.","difficulty":1}]},{"word_id":"new-hsk-1-0123","rank":123,"lemma":"工人","examples":[{"slot":3,"meaning_en":"worker","sentence":"那个工人在外边工作。","translation":"That worker is working outside.","difficulty":1}]},{"word_id":"new-hsk-1-0124","rank":124,"lemma":"工作","examples":[{"slot":3,"meaning_en":"work","sentence":"我姐姐在医院工作。","translation":"My older sister works at a hospital.","difficulty":1}]},{"word_id":"new-hsk-1-0125","rank":125,"lemma":"关","examples":[{"slot":3,"meaning_en":"turn off","sentence":"请关电视，我们睡觉吧。","translation":"Please turn off the TV, and let's go to sleep.","difficulty":1}]}]}
