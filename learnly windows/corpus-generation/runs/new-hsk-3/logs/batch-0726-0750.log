{"word":{"id":"new-hsk-3-0739","lang":"zh","lemma":"退出","display_form":"退出","pos":"unknown","rank":739,"pronunciation":"tuì chū"},"glosses":{"primary_gloss":"quit; withdraw","secondary_glosses":["exit"],"notes":"Used when a person leaves a competition, group, chat, game, or other activity."},"examples":[{"id":"new-hsk-3-0739-ex1","meaning_en":"withdraw","sentence":"他身体不舒服，所以退出比赛。","translation":"He did not feel well, so he withdrew from the competition.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0739-ex2","meaning_en":"exit","sentence":"不用的时候，记得先退出。","translation":"When you are not using it, remember to exit first.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0739-ex3","meaning_en":"quit","sentence":"她说要先退出，去洗澡。","translation":"She said she needed to leave first and go take a shower.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0739-ex1","translation":"He did not feel well, so he withdrew from the competition."},{"example_id":"new-hsk-3-0739-ex2","translation":"When you are not using it, remember to exit first."},{"example_id":"new-hsk-3-0739-ex3","translation":"She said she needed to leave first and go take a shower."}]}
