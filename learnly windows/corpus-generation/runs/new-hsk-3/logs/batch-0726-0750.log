./runs/new-hsk-2/hsk2-strict-repairs-batch2.jsonl:3:{"word": {"id": "new-hsk-2-0245", "lang": "zh", "lemma": "会", "display_form": "会", "pos": "noun", "rank": 245, "pronunciation": "huì"}, "glosses": {"primary_gloss": "meeting; gathering", "secondary_glosses": ["conference"], "notes": "The HSK2 noun sense, not the HSK1 auxiliary verb."}, "examples": [{"id": "new-hsk-2-0245-ex1", "sentence": "今天下午我们有个会。", "meaning_en": "meeting", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0245-ex2", "sentence": "老师正在开会，你先等一下。", "meaning_en": "be in a meeting", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0245-ex3", "sentence": "这个会很重要，经理也来。", "meaning_en": "important meeting", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0245-ex1", "translation": "We have a meeting this afternoon."}, {"example_id": "new-hsk-2-0245-ex2", "translation": "The teacher is in a meeting, so wait a moment first."}, {"example_id": "new-hsk-2-0245-ex3", "translation": "This meeting is important, and the manager is coming too."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch2.jsonl:4:{"word": {"id": "new-hsk-2-0247", "lang": "zh", "lemma": "或", "display_form": "或", "pos": "unknown", "rank": 247, "pronunciation": "huò"}, "glosses": {"primary_gloss": "or", "secondary_glosses": ["either"], "notes": "A concise written-style way to connect options."}, "examples": [{"id": "new-hsk-2-0247-ex1", "sentence": "水或牛奶都可以。", "meaning_en": "or", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0247-ex2", "sentence": "今天或明天去都行。", "meaning_en": "either option", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0247-ex3", "sentence": "你可以看书或听音乐。", "meaning_en": "choose between options", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0247-ex1", "translation": "Water or milk is fine."}, {"example_id": "new-hsk-2-0247-ex2", "translation": "Going today or tomorrow is okay."}, {"example_id": "new-hsk-2-0247-ex3", "translation": "You can read or listen to music."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch2.jsonl:5:{"word": {"id": "new-hsk-2-0248", "lang": "zh", "lemma": "或者", "display_form": "或者", "pos": "unknown", "rank": 248, "pronunciation": "huòzhě"}, "glosses": {"primary_gloss": "or", "secondary_glosses": ["or else", "either"], "notes": "Usually links two options; often slightly more formal or written than 还是 in some contexts."}, "examples": [{"id": "new-hsk-2-0248-ex1", "sentence": "你今天晚上或者明天早上来吧。", "meaning_en": "or", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0248-ex2", "sentence": "这件事你跟老师说，或者跟家长说。", "meaning_en": "or else", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0248-ex3", "sentence": "我们可以去公园，或者去广场走走。", "meaning_en": "choose between plans", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0248-ex1", "translation": "Come either tonight or tomorrow morning."}, {"example_id": "new-hsk-2-0248-ex2", "translation": "Tell the teacher about this, or tell the parents."}, {"example_id": "new-hsk-2-0248-ex3", "translation": "We can go to the park, or go walk around the square."}]}
./runs/new-hsk-2/hsk2-strict-repairs-batch2.jsonl:6:{"word": {"id": "new-hsk-2-0249", "lang": "zh", "lemma": "机会", "display_form": "机会", "pos": "unknown", "rank": 249, "pronunciation": "jīhuì"}, "glosses": {"primary_gloss": "chance; opportunity", "secondary_glosses": ["occasion"], "notes": "A favorable chance to do something."}, "examples": [{"id": "new-hsk-2-0249-ex1", "sentence": "这是一个很好的机会。", "meaning_en": "opportunity", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": true}, {"id": "new-hsk-2-0249-ex2", "sentence": "这样的机会不多。", "meaning_en": "chance", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}, {"id": "new-hsk-2-0249-ex3", "sentence": "我想给孩子一个机会。", "meaning_en": "give someone a chance", "difficulty": 2, "source": "strict-repair-2026-04-04", "is_primary": false}], "example_translations": [{"example_id": "new-hsk-2-0249-ex1", "translation": "This is a very good opportunity."}, {"example_id": "new-hsk-2-0249-ex2", "translation": "Opportunities like this are not common."}, {"example_id": "new-hsk-2-0249-ex3", "translation": "I want to give the child a chance."}]}
