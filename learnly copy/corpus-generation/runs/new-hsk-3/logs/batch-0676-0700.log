/Users/moi/Desktop/business/learnly/corpus-generation/runs/new-hsk-3/logs/batch-0651-0675.log:2231:+{"word":{"id":"new-hsk-3-0658","lang":"zh","lemma":"事实","display_form":"事实","pos":"unknown","rank":658,"pronunciation":"shìshí"},"glosses":{"primary_gloss":"fact","secondary_glosses":["truth"],"notes":"What is really true in a situation."},"examples":[{"id":"new-hsk-3-0658-ex1","meaning_en":"fact","sentence":"杯子是他打坏的，这是事实。","translation":"It is a fact that he broke the cup.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0658-ex2","meaning_en":"fact","sentence":"她没来上课，这是一个事实。","translation":"It is a fact that she did not come to class.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0658-ex3","meaning_en":"fact","sentence":"大家都知道这个事实。","translation":"Everyone knows this fact.","difficulty":1,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0658-ex1","translation":"It is a fact that he broke the cup."},{"example_id":"new-hsk-3-0658-ex2","translation":"It is a fact that she did not come to class."},{"example_id":"new-hsk-3-0658-ex3","translation":"Everyone knows this fact."}]}
/Users/moi/Desktop/business/learnly/corpus-generation/runs/new-hsk-3/logs/batch-0651-0675.log:2232:+{"word":{"id":"new-hsk-3-0659","lang":"zh","lemma":"事实上","display_form":"事实上","pos":"unknown","rank":659,"pronunciation":"shì shí shàng"},"glosses":{"primary_gloss":"in fact","secondary_glosses":["actually"],"notes":"Adverb used to correct or clarify what is really true."},"examples":[{"id":"new-hsk-3-0659-ex1","meaning_en":"in fact","sentence":"我以为她在家，事实上她在公司。","translation":"I thought she was at home, but in fact she was at the office.","difficulty":1,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0659-ex2","meaning_en":"in fact","sentence":"这件衣服不贵，事实上很便宜。","translation":"This piece of clothing is not expensive; in fact, it is quite cheap.","difficulty":1,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0659-ex3","meaning_en":"actually","sentence":"我以为今天会下雨，事实上天气很好。","translation":"I thought it would rain today, but actually the weather is very nice.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0659-ex1","translation":"I thought she was at home, but in fact she was at the office."},{"example_id":"new-hsk-3-0659-ex2","translation":"This piece of clothing is not expensive; in fact, it is quite cheap."},{"example_id":"new-hsk-3-0659-ex3","translation":"I thought it would rain today, but actually the weather is very nice."}]}
