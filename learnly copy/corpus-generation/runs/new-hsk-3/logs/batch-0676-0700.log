def show_coverage(dataset_id: str) -> None:
    with connect() as conn:
        seed_count = conn.execute(
            """
            SELECT COUNT(*)
            FROM source_translation_seeds
            WHERE dataset_id = ?
            """,
            (dataset_id,),
        ).fetchone()[0]
        complete_count = conn.execute(
            """
            SELECT COUNT(*)
            FROM words
            WHERE id LIKE ?
            """,
            (f"{dataset_word_prefix(dataset_id)}-%",),
        ).fetchone()[0]

