/Users/moi/Desktop/business/learnly/corpus-generation/runs/new-hsk-3/logs/batch-0651-0675.log:2260:{"word":{"id":"new-hsk-3-0656","lang":"zh","lemma":"事故","display_form":"事故","pos":"unknown","rank":656,"pronunciation":"shìgù"},"glosses":{"primary_gloss":"accident","secondary_glosses":["incident"],"notes":"Usually an unexpected bad event such as a traffic accident."},"examples":[{"id":"new-hsk-3-0656-ex1","meaning_en":"accident","sentence":"前面有事故，我们得下车走。","translation":"There is an accident ahead, so we have to get out and walk.","difficulty":2,"source":"generator-3","is_primary":true},{"id":"new-hsk-3-0656-ex2","meaning_en":"accident","sentence":"路上出了小事故，所以车很慢。","translation":"There was a small accident on the road, so the cars are moving slowly.","difficulty":2,"source":"generator-3","is_primary":false},{"id":"new-hsk-3-0656-ex3","meaning_en":"accident","sentence":"新闻里说今天早上有事故。","translation":"The news said there was an accident this morning.","difficulty":2,"source":"generator-3","is_primary":false}],"example_translations":[{"example_id":"new-hsk-3-0656-ex1","translation":"There is an accident ahead, so we have to get out and walk."},{"example_id":"new-hsk-3-0656-ex2","translation":"There was a small accident on the road, so the cars are moving slowly."},{"example_id":"new-hsk-3-0656-ex3","translation":"The news said there was an accident this morning."}]}
