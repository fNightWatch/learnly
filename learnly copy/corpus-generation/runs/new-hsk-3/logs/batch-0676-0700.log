            line = line.strip()
            if not line:
                continue
            payload = json.loads(line)
            word = payload["word"]
            glosses = payload["glosses"]
            examples = payload["examples"]
            translations = payload["example_translations"]

            word_id = word["id"]
            if word_id in seen_word_ids:
